PORT=4000
DATABASE_URL=postgres://postgres:postgres@db:5432/basket
SESSION_SECRET=change-me-in-prod
CORS_ORIGIN=http://localhost:4322
COOKIE_NAME=basket_sid
NODE_ENV=development

# true = backend auto-loads demo data on boot (players, tournaments, matches).
EXAMPLE_DATA=true

# Required when EXAMPLE_DATA=false so a fresh DB still has a usable admin
# login (the seed admins only exist when EXAMPLE_DATA=true). The Python E2E
# test (backend/test/full_flow.py) also reads these defaults.
BOOTSTRAP_ADMIN_USERNAME=tester
BOOTSTRAP_ADMIN_PASSWORD=test1234
