{
  "name": "basket-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts migrate:up",
    "migrate:status": "tsx src/db/migrate-cli.ts status",
    "migrate:mark": "tsx src/db/migrate-cli.ts migrate:mark",
    "seed": "tsx src/db/migrate-cli.ts seed:up",
    "seed:mark": "tsx src/db/migrate-cli.ts seed:mark"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.19.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3"
  }
}
