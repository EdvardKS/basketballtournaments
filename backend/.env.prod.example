# Backend production env. Copy to backend/.env.prod and replace every
# value marked as change-me before deploying.
PORT=4000
DATABASE_URL=postgres://basket:change-me-strong-password@db:5432/basket
SESSION_SECRET=change-me-long-random-string
CORS_ORIGIN=http://localhost:4322
COOKIE_NAME=basket_sid
# Only flip to true when serving over HTTPS. Plain-HTTP localhost → leave false.
COOKIE_SECURE=false
NODE_ENV=production

# Production default: no demo data. Flip to true only for staging / demo boxes.
EXAMPLE_DATA=false
