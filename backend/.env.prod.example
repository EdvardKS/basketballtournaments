# Backend production env. Copy to backend/.env.prod and replace every
# value marked as change-me before deploying.
PORT=4000
DATABASE_URL=postgres://basket:change-me-strong-password@db:5432/basket
SESSION_SECRET=change-me-long-random-string
CORS_ORIGIN=http://localhost:4322
COOKIE_NAME=basket_sid
# Only flip to true when serving over HTTPS. Plain-HTTP localhost → leave false.
COOKIE_SECURE=false
NODE_ENV=production

# Production default: no demo data. Flip to true only for staging / demo boxes.
EXAMPLE_DATA=false

# Bootstrap admin: created/updated on every backend boot, regardless of
# EXAMPLE_DATA. Login is by username. Leave both blank to skip.
# The mobile column is filled with a synthetic value (admin:<username>) and
# can be overridden via BOOTSTRAP_ADMIN_MOBILE if you ever need a real number.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional cosmetic / override:
# BOOTSTRAP_ADMIN_NAME=Jaime
# BOOTSTRAP_ADMIN_MOBILE=700000099
