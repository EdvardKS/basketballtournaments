---
import Main from "../../layouts/Main.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import TournamentCard from "../../components/TournamentCard.astro";
import { requireAuth } from "../../lib/session.js";
import { api, getCookieHeader } from "../../lib/api.js";
import type { Tournament } from "../../lib/types.js";

const { redirect, session } = await requireAuth(Astro.request);
if (redirect) return Astro.redirect(redirect);
if (session.player?.role === "admin") return Astro.redirect("/dashboard/admin");
if (session.player?.role === "captain") return Astro.redirect("/dashboard/captain");

const cookie = getCookieHeader(Astro.request);
const player = session.player!;

let tournaments: Tournament[] = [];
try { tournaments = await api<Tournament[]>("/tournaments", {}, cookie); } catch { /* empty */ }

const active = tournaments.find((t) => !["completed","upcoming"].includes(t.status)) ?? null;
---
<Main title="Mi panel" player={player}>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <h1 class="font-display text-4xl text-white">Hola, {player.name.split(" ")[0]}</h1>
        <p class="text-court-muted text-sm">Panel del jugador</p>
      </div>
      <button
        id="btn-logout"
        type="button"
        class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-semibold uppercase tracking-wider text-[var(--color-neon-red)] border border-[var(--color-neon-red)]/30 hover:bg-[var(--color-neon-red)]/10 hover:shadow-[0_0_14px_rgba(255,45,45,0.45)] transition-all cursor-pointer"
      >
        Salir
      </button>
      <script>
        document.getElementById("btn-logout")?.addEventListener("click", async () => {
          await fetch("/api/auth/logout", { method: "POST", credentials: "include" }).catch(() => {});
          window.location.href = "/?welcome=logout";
        });
      </script>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-1">
        <h2 class="font-display text-2xl text-white mb-3">Mi perfil</h2>
        <PlayerCard player={player} authenticated showContact={false} />
        <div class="mt-4 card space-y-2">
          <p class="label-text">Estadísticas</p>
          {[
            ["Ritmo", player.pace], ["Tiro", player.shooting], ["Pase", player.passing],
            ["Bote", player.dribbling], ["Defensa", player.defense], ["Físico", player.physical],
          ].map(([label, val]) => (
            <div class="flex items-center gap-2">
              <span class="text-xs text-court-muted w-16 shrink-0">{label}</span>
              <div class="flex-1 h-1.5 bg-court-border rounded-full overflow-hidden">
                <div class="h-full bg-court-accent rounded-full" style={`width:${val}%`} />
              </div>
              <span class="text-xs font-bold text-white w-6 text-right">{val}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-display text-2xl text-white mb-3">Torneo activo</h2>
        {active ? (
          <TournamentCard tournament={active} />
        ) : (
          <div class="card text-center py-12">
            <p class="text-4xl mb-3">🏀</p>
            <p class="text-court-muted">No hay torneo activo en este momento</p>
            <a href="/" class="btn-ghost mt-4 inline-flex">Ver todos los torneos</a>
          </div>
        )}
      </div>
    </div>
  </div>
</Main>
