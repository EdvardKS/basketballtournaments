---
import Main from "../../layouts/Main.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import TournamentCard from "../../components/TournamentCard.astro";
import CromoCard from "../../components/cromo/CromoCard.astro";
import PlayerProfileEditor from "../../islands/PlayerProfileEditor.tsx";
import PlayerStatsRedistributor from "../../islands/PlayerStatsRedistributor.tsx";
import CromoShare from "../../islands/CromoShare.tsx";
import { requireAuth } from "../../lib/session.js";
import { api, getCookieHeader } from "../../lib/api.js";
import type { Tournament, Achievement } from "../../lib/types.js";

const { redirect, session } = await requireAuth(Astro.request);
if (redirect) return Astro.redirect(redirect);
if (session.player?.role === "admin") return Astro.redirect("/dashboard/admin");
if (session.player?.role === "captain") return Astro.redirect("/dashboard/captain");

const cookie = getCookieHeader(Astro.request);
const player = session.player!;

let tournaments: Tournament[] = [];
try { tournaments = await api<Tournament[]>("/tournaments", {}, cookie); } catch { /* empty */ }
const active = tournaments.find((t) => !["completed","upcoming"].includes(t.status)) ?? null;

let achievements: Achievement[] = [];
try { achievements = await api<Achievement[]>(`/players/${player.id}/achievements`, {}, cookie); } catch { /* empty */ }
---
<Main title="Mi panel" player={player}>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <h1 class="font-display text-4xl text-white">Hola, {player.name.split(" ")[0]}</h1>
        <p class="text-court-muted text-sm">Panel del jugador</p>
      </div>
      <button id="btn-logout" type="button"
        class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-semibold uppercase tracking-wider text-[var(--color-neon-red)] border border-[var(--color-neon-red)]/30 hover:bg-[var(--color-neon-red)]/10 transition-all">
        Salir
      </button>
      <script>
        document.getElementById("btn-logout")?.addEventListener("click", async () => {
          await fetch("/api/auth/logout", { method: "POST", credentials: "include" }).catch(() => {});
          window.location.href = "/?welcome=logout";
        });
      </script>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-1 space-y-4">
        <h2 class="font-display text-2xl text-white">Mi perfil</h2>
        <PlayerCard player={player} authenticated showContact={false} />
        <PlayerProfileEditor player={player} client:visible />
        <PlayerStatsRedistributor player={player} client:visible />
      </div>

      <div class="lg:col-span-2 space-y-6">
        <div>
          <h2 class="font-display text-2xl text-white mb-3">Torneo activo</h2>
          {active ? <TournamentCard tournament={active} /> : (
            <div class="card text-center py-12">
              <p class="text-4xl mb-3">🏀</p>
              <p class="text-court-muted">No hay torneo activo en este momento</p>
              <a href="/" class="btn-ghost mt-4 inline-flex">Ver todos los torneos</a>
            </div>
          )}
        </div>
        <div>
          <h2 class="font-display text-2xl text-white mb-3">Mi cromo</h2>
          <CromoCard player={player} achievements={achievements} />
          <div class="mt-3">
            <CromoShare playerName={player.name} playerId={player.id} client:visible />
          </div>
        </div>
      </div>
    </div>
  </div>
</Main>
