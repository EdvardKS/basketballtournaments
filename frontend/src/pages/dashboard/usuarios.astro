---
import Main from "../../layouts/Main.astro";
import AdminUsersManager from "../../islands/AdminUsersManager.tsx";
import { requireRole } from "../../lib/session.js";
import { api, getCookieHeader } from "../../lib/api.js";
import type { Player } from "../../lib/types.js";

const { redirect, session } = await requireRole(Astro.request, "admin");
if (redirect) return Astro.redirect(redirect);

const cookie = getCookieHeader(Astro.request);
let players: Player[] = [];
try { players = await api<Player[]>("/players", {}, cookie); } catch { /* empty */ }
---
<Main title="Gestión de usuarios" player={session.player}>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-4">
    <div>
      <p class="text-[11px] uppercase tracking-[0.4em] text-[var(--color-neon-orange)] font-bold mb-1">Usuarios registrados</p>
      <h1 class="font-hero text-3xl text-white leading-none">GESTIÓN <span class="text-neon-orange">GLOBAL</span></h1>
      <p class="text-court-muted text-sm mt-2">Todos los jugadores. Sanciones, premios y CRUD completo.</p>
    </div>
    <div class="card">
      <AdminUsersManager initial={players} client:load />
    </div>
  </div>
</Main>
