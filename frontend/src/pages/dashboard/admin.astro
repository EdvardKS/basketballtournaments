---
import Main from "../../layouts/Main.astro";
import AdminPanel from "../../islands/admin/AdminPanel.js";
import { requireRole } from "../../lib/session.js";
import { api, getCookieHeader } from "../../lib/api.js";
import { computeEffectiveStatus } from "../../lib/display.js";
import type { Tournament, Player, TournamentStatus } from "../../lib/types.js";

const { redirect, session } = await requireRole(Astro.request, "admin");
if (redirect) return Astro.redirect(redirect);

const cookie = getCookieHeader(Astro.request);

let tournaments: Tournament[] = [];
let allPlayers: Player[] = [];

try { tournaments = await api<Tournament[]>("/tournaments", {}, cookie); } catch { /* empty */ }
try { allPlayers = await api<Player[]>("/players", {}, cookie); } catch { /* empty */ }

// Pick the most operationally-relevant tournament: anything live > upcoming > completed
const ACTIVE: TournamentStatus[] = ["open", "draft", "setup", "scheduled", "active"];
const enriched = tournaments.map((t) => ({ t, eff: computeEffectiveStatus(t) }));
const initialActive =
  enriched.find((e) => ACTIVE.includes(e.eff))?.t ??
  enriched.find((e) => e.eff === "upcoming")?.t ??
  tournaments[0] ??
  null;
---
<Main title="Panel admin" player={session.player}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <AdminPanel
      tournaments={tournaments}
      initialActiveId={initialActive?.id ?? null}
      allPlayers={allPlayers}
      client:load
    />
  </div>
</Main>
