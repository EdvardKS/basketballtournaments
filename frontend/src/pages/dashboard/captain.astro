---
import Main from "../../layouts/Main.astro";
import TeamSettings from "../../islands/TeamSettings.js";
import DraftBoard from "../../islands/DraftBoard.js";
import { requireRole } from "../../lib/session.js";
import { api, getCookieHeader } from "../../lib/api.js";
import type { Tournament, Team } from "../../lib/types.js";

const { redirect, session } = await requireRole(Astro.request, "captain");
if (redirect) return Astro.redirect(redirect);

const cookie = getCookieHeader(Astro.request);
const player = session.player!;

let tournaments: Tournament[] = [];
let myTeam: Team | null = null;

try { tournaments = await api<Tournament[]>("/tournaments", {}, cookie); } catch { /* empty */ }

const active = tournaments.find((t) => !["completed","upcoming"].includes(t.status)) ?? null;

if (active) {
  try {
    const detail = await api<{ teams: (Team & { captainId: string })[] }>(`/tournaments/${active.id}`, {}, cookie);
    myTeam = detail.teams.find((t) => t.captainId === player.id) ?? null;
  } catch { /* empty */ }
}

const isDraft = active?.status === "draft";
---
<Main title="Panel capitán" player={player}>
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <div>
      <h1 class="font-display text-4xl text-white">Panel del Capitán</h1>
      <p class="text-court-muted text-sm">{player.name}</p>
    </div>

    {!active && (
      <div class="card text-center py-12">
        <p class="text-4xl mb-3">🏀</p>
        <p class="text-court-muted">No hay torneo activo actualmente</p>
      </div>
    )}

    {active && (
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <h2 class="font-display text-2xl text-white">{active.name}</h2>
          <a href={`/tournaments/${active.id}`} class="btn-ghost text-xs">Ver torneo</a>
        </div>

        {myTeam && (
          <TeamSettings
            team={myTeam}
            matchDate={active.matchDate}
            client:load
          />
        )}

        {isDraft && (
          <div>
            <h3 class="font-display text-2xl text-white mb-3">Draft en vivo</h3>
            <DraftBoard
              tournamentId={active.id}
              myTeamId={myTeam?.id ?? null}
              client:load
            />
          </div>
        )}

        {!isDraft && !myTeam && (
          <div class="card text-center py-8">
            <p class="text-court-muted">El administrador te asignará un equipo cuando comience el draft</p>
          </div>
        )}
      </div>
    )}
  </div>
</Main>
