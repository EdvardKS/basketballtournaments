---
import Main from "../../layouts/Main.astro";
import CromoCard from "../../components/cromo/CromoCard.astro";
import CromoMedals from "../../components/cromo/CromoMedals.astro";
import PlayerInfoCard from "../../components/PlayerInfoCard.astro";
import PlayerStatsReadonly from "../../components/PlayerStatsReadonly.astro";
import PlayerProfileModals from "../../islands/PlayerProfileModals.tsx";
import CromoShare from "../../islands/CromoShare.tsx";
import { requireRole } from "../../lib/session.js";
import { api, getCookieHeader } from "../../lib/api.js";
import type { Achievement } from "../../lib/types.js";

const { redirect, session } = await requireRole(Astro.request, "captain");
if (redirect) return Astro.redirect(redirect);

const cookie = getCookieHeader(Astro.request);
const player = session.player!;

let achievements: Achievement[] = [];
try { achievements = await api<Achievement[]>(`/players/${player.id}/achievements`, {}, cookie); } catch { /* empty */ }
---
<Main title="Mi panel" player={player}>
  <div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
    <div>
      <h1 class="font-display text-4xl text-white">Hola, {player.name.split(" ")[0]}</h1>
      <p class="text-court-muted text-sm">Panel del capitán</p>
    </div>

    <CromoCard player={player} />
    <CromoShare playerName={player.name} playerId={player.id} client:visible />

    <div class="card space-y-2">
      <p class="label-text">Medallas</p>
      <CromoMedals achievements={achievements} />
    </div>

    <PlayerInfoCard player={player} />
    <PlayerStatsReadonly player={player} />
    <PlayerProfileModals player={player} client:visible />
  </div>
</Main>
