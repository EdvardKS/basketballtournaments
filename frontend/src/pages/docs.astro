---
import Main from "../layouts/Main.astro";
import { loadSession } from "../lib/session.js";
const session = await loadSession(Astro.request);
---
<Main title="Bases del torneo" player={session.player}>
  <article class="max-w-3xl mx-auto px-4 py-12 prose prose-invert prose-sm max-w-none">
    <h1 class="font-display text-5xl text-white mb-2">Bases del torneo</h1>
    <p class="text-court-muted mb-8">Villena Basket League · Temporada 2026</p>

    <div class="card space-y-6">
      <section>
        <h2 class="font-display text-2xl text-court-accent">Formato</h2>
        <ul class="text-court-muted text-sm space-y-1 list-disc list-inside">
          <li>Baloncesto <strong class="text-white">3x3</strong> en media cancha (2 partidos simultáneos)</li>
          <li>Partidos de 20 minutos de duración</li>
          <li>Fase de grupos + eliminatorias</li>
          <li>Reglas FIBA 3x3 adaptadas al formato amateur</li>
        </ul>
      </section>

      <section>
        <h2 class="font-display text-2xl text-court-accent">Fases del torneo</h2>
        <ol class="text-court-muted text-sm space-y-2 list-decimal list-inside">
          <li><strong class="text-white">Inscripción:</strong> Los jugadores se registran en la plataforma durante el periodo abierto.</li>
          <li><strong class="text-white">Draft:</strong> Los capitanes eligen jugadores por turnos en rondas rotativas aleatorias.</li>
          <li><strong class="text-white">Grupos:</strong> Los equipos se dividen en grupos. Cada equipo se enfrenta a todos los del grupo.</li>
          <li><strong class="text-white">Eliminatorias:</strong> Los mejores de cada grupo avanzan a cuartos, semis y final.</li>
        </ol>
      </section>

      <section>
        <h2 class="font-display text-2xl text-court-accent">Sistema de puntuación (grupos)</h2>
        <ul class="text-court-muted text-sm space-y-1 list-disc list-inside">
          <li>Victoria: <strong class="text-court-ok">2 puntos</strong></li>
          <li>Derrota: <strong class="text-court-danger">0 puntos</strong></li>
          <li>Desempate: diferencia de puntos anotados</li>
        </ul>
      </section>

      <section>
        <h2 class="font-display text-2xl text-court-accent">Privacidad</h2>
        <p class="text-court-muted text-sm">Los nombres de los jugadores solo son visibles para usuarios registrados. Los visitantes anónimos solo ven nombres y logos de equipos.</p>
      </section>
    </div>
  </article>
</Main>
