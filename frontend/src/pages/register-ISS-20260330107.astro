---
import Main from "../layouts/Main.astro";
import RegisterForm from "../islands/RegisterForm.tsx";
---
<Main title="Crear cuenta — Villena Basket">
  <section class="max-w-2xl mx-auto">
    <h1 class="text-5xl text-court-accent mb-2">CREAR CUENTA</h1>
    <p class="text-slate-400 mb-6 text-sm">
      Configura tu carta como en FIFA: estadísticas y un overall calculado
      automáticamente. Podrás inscribirte a cualquier torneo abierto nada más
      registrarte.
    </p>
    <div class="card">
      <RegisterForm client:load />
    </div>
  </section>
</Main>
