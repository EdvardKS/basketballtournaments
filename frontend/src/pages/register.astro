---
import Main from "../layouts/Main.astro";
import RegisterForm from "../islands/RegisterForm.js";
import { loadSession } from "../lib/session.js";

const session = await loadSession(Astro.request);
if (session.isAuthenticated) return Astro.redirect("/dashboard/player");
---
<Main title="Crear cuenta" player={null}>
  <div class="max-w-7xl mx-auto px-4 py-16">
    <RegisterForm client:load />
  </div>
</Main>
