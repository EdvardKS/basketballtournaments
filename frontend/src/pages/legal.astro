---
import Main from "../layouts/Main.astro";
import { loadSession } from "../lib/session.js";
const session = await loadSession(Astro.request);
---
<Main title="Legal & Privacidad" player={session.player}>
  <article class="max-w-3xl mx-auto px-4 py-12 space-y-6">
    <h1 class="font-display text-5xl text-white">Legal &amp; Privacidad</h1>
    <p class="text-court-muted text-sm">
      La información legal de esta aplicación está dividida en tres documentos:
    </p>
    <ul class="space-y-3 text-base">
      <li>
        <a href="/aviso-legal" class="text-white underline underline-offset-4 hover:text-court-accent">
          Aviso legal
        </a>
        <span class="text-court-muted"> · Datos identificativos del titular, objeto y condiciones de uso.</span>
      </li>
      <li>
        <a href="/privacidad" class="text-white underline underline-offset-4 hover:text-court-accent">
          Política de privacidad
        </a>
        <span class="text-court-muted"> · Responsable del tratamiento, finalidad, legitimación, conservación y derechos del interesado.</span>
      </li>
      <li>
        <a href="/cookies" class="text-white underline underline-offset-4 hover:text-court-accent">
          Política de cookies
        </a>
        <span class="text-court-muted"> · Tipos de cookies utilizadas, gestión y actualización.</span>
      </li>
    </ul>
    <p class="text-court-muted text-xs pt-4 border-t border-court-border">
      Titular y responsable: Asador La Morenica · C/ Celada 72, Villena (03400) Alicante · 965813907 / 686536975 · asadorlamorenica@gmail.com
    </p>
  </article>
</Main>
