---
import Main from "../layouts/Main.astro";
import HeroBanner from "../components/HeroBanner.astro";
import TournamentCard from "../components/TournamentCard.astro";
import PastTournamentsTimeline from "../components/PastTournamentsTimeline.astro";
import { loadSession } from "../lib/session.js";
import { api, getCookieHeader } from "../lib/api.js";
import type { Tournament } from "../lib/types.js";

const session = await loadSession(Astro.request);
const cookie = getCookieHeader(Astro.request);

let tournaments: Tournament[] = [];
try { tournaments = await api<Tournament[]>("/tournaments", {}, cookie); } catch { /* empty */ }

const active = tournaments.find((t) => !["completed","upcoming"].includes(t.status)) ?? null;
const upcoming = tournaments.find((t) => t.status === "upcoming") ?? null;
---
<Main title="Villena Basket League" player={session.player}>
  <HeroBanner active={active ?? upcoming} />

  <section class="max-w-7xl mx-auto px-4 py-10">
    {active && (
      <div class="mb-10">
        <h2 class="font-display text-3xl text-white mb-4">Torneo activo</h2>
        <TournamentCard tournament={active} />
      </div>
    )}

    {!active && tournaments.filter((t) => !["completed"].includes(t.status)).length > 0 && (
      <div class="mb-10">
        <h2 class="font-display text-3xl text-white mb-4">Próximos torneos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {tournaments
            .filter((t) => !["completed"].includes(t.status))
            .map((t) => <TournamentCard tournament={t} />)}
        </div>
      </div>
    )}
  </section>

  <PastTournamentsTimeline tournaments={tournaments} />
</Main>
