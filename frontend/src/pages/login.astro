---
import Main from "../layouts/Main.astro";
import LoginForm from "../islands/LoginForm.js";
import { loadSession } from "../lib/session.js";

const session = await loadSession(Astro.request);
if (session.isAuthenticated) {
  const role = session.player?.role;
  return Astro.redirect(role === "admin" ? "/dashboard/admin" : role === "captain" ? "/dashboard/captain" : "/dashboard/player");
}
---
<Main title="Iniciar sesión" player={null}>
  <div class="max-w-7xl mx-auto px-4 py-16">
    <LoginForm client:load />
  </div>
</Main>
