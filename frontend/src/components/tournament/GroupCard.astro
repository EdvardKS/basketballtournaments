---
import type { GroupWithMembers, Match } from "../../lib/types.js";
import MatchCard from "../MatchCard.astro";

interface Props {
  group: GroupWithMembers;
  matches: Match[];        // ALL tournament matches; we filter by groupId
  hoursConfirmed?: boolean;
}
const { group: gw, matches, hoursConfirmed = false } = Astro.props;
const { group, members } = gw;
const groupMatches = matches.filter((m) => m.stage === "group" && m.groupId === group.id);
const played = groupMatches.filter((m) => m.status === "completed").length;
const total = groupMatches.length;
const inProgress = groupMatches.some((m) => m.status === "in_progress");
---
<article class="glass p-5 sm:p-6 animate-slide-up">
  <header class="flex items-end justify-between mb-4 gap-3">
    <div>
      <p class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-neon-orange)] font-bold mb-1">Grupo</p>
      <h3 class="font-hero text-3xl text-white leading-none">{group.name}</h3>
    </div>
    <div class="text-right">
      {inProgress && (
        <span class="inline-flex items-center gap-1.5 mb-1 px-2 py-0.5 rounded-full text-[9px] uppercase tracking-widest font-bold text-[var(--color-neon-red)] border border-[var(--color-neon-red)]/40 bg-[var(--color-neon-red)]/10">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-neon-red)] animate-pulse" /> En juego
        </span>
      )}
      <p class="text-xs text-court-muted">
        <span class="font-hero text-base text-white tabular-nums">{played}<span class="text-white/30">/{total}</span></span> partidos
      </p>
    </div>
  </header>

  <!-- Standings -->
  <div class="overflow-x-auto -mx-2">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-court-muted text-[10px] uppercase tracking-wider border-b border-white/10">
          <th class="px-2 pb-2">#</th>
          <th class="px-2 pb-2">Equipo</th>
          <th class="px-2 pb-2 text-center">PJ</th>
          <th class="px-2 pb-2 text-center">G</th>
          <th class="px-2 pb-2 text-center">P</th>
          <th class="px-2 pb-2 text-center hidden sm:table-cell">PF</th>
          <th class="px-2 pb-2 text-center hidden sm:table-cell">PC</th>
          <th class="px-2 pb-2 text-center font-bold text-white">Pts</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {members.map((m, i) => {
          const isLeader = i === 0 && m.gamesPlayed > 0;
          const qualifies = i < 2; // top 2 typically advance
          return (
            <tr class:list={[
              "transition-colors",
              isLeader && "bg-court-gold/5",
              !isLeader && qualifies && "bg-court-ok/5",
            ]}>
              <td class="px-2 py-2">
                <span class:list={[
                  "font-hero text-xl tabular-nums",
                  isLeader ? "text-court-gold" : qualifies ? "text-court-ok" : "text-court-muted",
                ]}>{i + 1}</span>
              </td>
              <td class="px-2 py-2">
                <div class="flex items-center gap-2">
                  {m.teamLogo ? (
                    <img src={m.teamLogo} class="w-6 h-6 rounded object-cover" alt="" />
                  ) : (
                    <div class="w-6 h-6 rounded bg-white/10 flex items-center justify-center text-[10px] text-white/70 font-hero">
                      {m.teamName?.charAt(0) ?? "?"}
                    </div>
                  )}
                  <span class="font-semibold text-white text-sm truncate">{m.teamName ?? "—"}</span>
                </div>
              </td>
              <td class="px-2 py-2 text-center text-court-muted tabular-nums">{m.gamesPlayed}</td>
              <td class="px-2 py-2 text-center text-court-ok tabular-nums">{m.gamesWon}</td>
              <td class="px-2 py-2 text-center text-court-danger tabular-nums">{m.gamesLost}</td>
              <td class="px-2 py-2 text-center text-court-muted tabular-nums hidden sm:table-cell">{m.pointsFor}</td>
              <td class="px-2 py-2 text-center text-court-muted tabular-nums hidden sm:table-cell">{m.pointsAgainst}</td>
              <td class="px-2 py-2 text-center font-hero text-2xl text-[var(--color-neon-orange)] tabular-nums">{m.points}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- Matches of this group -->
  {groupMatches.length > 0 && (
    <div class="mt-5 pt-5 border-t border-white/5">
      <p class="text-[10px] uppercase tracking-[0.3em] text-court-muted font-bold mb-3">Partidos del grupo</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {groupMatches.map((m) => (
          <MatchCard match={m} hoursConfirmed={hoursConfirmed} />
        ))}
      </div>
    </div>
  )}
</article>
