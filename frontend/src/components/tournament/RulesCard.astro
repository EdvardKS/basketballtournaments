---
import type { Tournament } from "../../lib/types.js";

interface Props { tournament: Tournament }
const { tournament: t } = Astro.props;

const cards = [
  {
    title: t.halfCourt ? "3×3 Media Cancha" : "3×3 Pista Completa",
    desc: `Equipos de ${t.teamSize} en pista, ${t.halfCourt ? "media cancha" : "cancha completa"}.`,
    color: "#ff6b00",
    icon: '<rect x="3" y="6" width="18" height="12" rx="1" fill="none"/><line x1="12" y1="6" x2="12" y2="18"/><circle cx="12" cy="12" r="3" fill="none"/>',
  },
  {
    title: `Partidos de ${t.gameDurationMinutes} min`,
    desc: "Cronómetro corrido salvo últimos minutos del cuarto decisivo.",
    color: "#0066ff",
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    title: `${t.courtCount} ${t.courtCount === 1 ? "cancha simultánea" : "canchas simultáneas"}`,
    desc: t.courtCount > 1 ? "Partidos en paralelo para acelerar la jornada." : "Una cancha activa toda la jornada.",
    color: "#ff2d2d",
    icon: '<rect x="3" y="5" width="8" height="14" rx="1" fill="none"/><rect x="13" y="5" width="8" height="14" rx="1" fill="none"/>',
  },
  {
    title: "Reglas FIBA 3×3 adaptadas",
    desc: "Posesión por reloj de 12s, 1 punto/2 puntos, balón a la línea tras canasta.",
    color: "#f5c518",
    icon: '<path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10" fill="none"/>',
  },
];
---
<section>
  <header class="mb-5">
    <p class="text-[11px] uppercase tracking-[0.4em] text-[var(--color-neon-orange)] font-bold mb-2">Bases del torneo</p>
    <h2 class="font-hero text-3xl sm:text-4xl text-white leading-none">FORMATO &amp; <span class="text-neon-orange">REGLAS</span></h2>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {cards.map((c, i) => (
      <article
        class="group relative rounded-2xl border border-white/5 bg-court-card/60 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-white/15 animate-slide-up"
        style={`animation-delay:${i * 80}ms;`}
      >
        <div
          class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none rounded-2xl"
          style={`background: radial-gradient(circle at 50% 0%, ${c.color}25, transparent 70%);`}
          aria-hidden="true"
        />
        <div
          class="relative w-11 h-11 rounded-xl flex items-center justify-center mb-4 border"
          style={`background:${c.color}1A; border-color:${c.color}66; color:${c.color}; box-shadow: 0 0 18px ${c.color}55;`}
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
        </div>
        <h3 class="font-hero text-xl text-white leading-none mb-2">{c.title}</h3>
        <p class="text-xs text-court-muted leading-relaxed">{c.desc}</p>
      </article>
    ))}
  </div>

  {t.rules && (
    <details class="mt-6 glass p-5 group">
      <summary class="cursor-pointer text-sm font-semibold uppercase tracking-widest text-court-muted hover:text-white transition-colors flex items-center gap-2">
        <svg class="w-4 h-4 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        Bases completas
      </summary>
      <pre class="mt-4 text-court-muted text-sm whitespace-pre-wrap font-body">{t.rules}</pre>
    </details>
  )}
</section>
