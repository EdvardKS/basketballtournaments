---
import type { Match } from "../lib/types.js";
import { formatTime } from "../lib/display.js";

interface Props { match: Match; hoursConfirmed?: boolean }
const { match: m, hoursConfirmed = false } = Astro.props;

const STATUS_BG: Record<string, string> = {
  pending: "border-court-border",
  in_progress: "border-court-accent",
  completed: "border-court-ok/40",
};

// Diagnostic flag: a saved score on a non-completed match means the standings
// haven't been credited yet. Surface it loudly so admins know to hit "Finalizar".
const hasScore = m.homeScore != null || m.awayScore != null;
const needsFinalize = hasScore && m.status !== "completed";
---
<div class:list={[
  "card border transition-all",
  needsFinalize ? "border-court-warn/60" : (STATUS_BG[m.status] ?? "border-court-border"),
]}>
  {m.status === "in_progress" && (
    <div class="flex items-center gap-2 mb-2">
      <span class="w-2 h-2 rounded-full bg-court-accent animate-pulse" />
      <span class="text-xs font-semibold text-court-accent uppercase tracking-wider">En juego</span>
    </div>
  )}
  {needsFinalize && (
    <div class="flex items-center gap-2 mb-2 px-2 py-1 rounded-md text-[10px] uppercase tracking-widest font-bold text-court-warn border border-court-warn/40 bg-court-warn/10">
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="13" /><circle cx="12" cy="16.5" r="0.5" fill="currentColor" />
      </svg>
      Pendiente de finalizar — los puntos no cuentan aún
    </div>
  )}

  <div class="flex items-center gap-3">
    <!-- Home team -->
    <div class="flex-1 flex flex-col items-center gap-1 text-center">
      {m.homeTeamLogo ? (
        <img src={m.homeTeamLogo} class="w-10 h-10 rounded-lg object-cover" alt="" />
      ) : (
        <div class="w-10 h-10 rounded-lg bg-court-border flex items-center justify-center text-court-muted font-display">
          {m.homeTeamName?.charAt(0) ?? "?"}
        </div>
      )}
      <span class="text-xs font-semibold text-white truncate w-full">{m.homeTeamName ?? "TBD"}</span>
    </div>

    <!-- Score -->
    <div class="flex flex-col items-center gap-0.5 min-w-[64px]">
      <div class="flex items-center gap-2">
        <span class:list={["font-display text-3xl font-bold", m.homeScore != null ? "text-white" : "text-court-muted"]}>
          {m.homeScore ?? "—"}
        </span>
        <span class="text-court-muted font-display text-xl">:</span>
        <span class:list={["font-display text-3xl font-bold", m.awayScore != null ? "text-white" : "text-court-muted"]}>
          {m.awayScore ?? "—"}
        </span>
      </div>
      <span class="text-[10px] text-court-muted">
        {hoursConfirmed && m.scheduledAt ? formatTime(m.scheduledAt) : (m.status === "pending" ? "Por confirmar" : "")}
      </span>
    </div>

    <!-- Away team -->
    <div class="flex-1 flex flex-col items-center gap-1 text-center">
      {m.awayTeamLogo ? (
        <img src={m.awayTeamLogo} class="w-10 h-10 rounded-lg object-cover" alt="" />
      ) : (
        <div class="w-10 h-10 rounded-lg bg-court-border flex items-center justify-center text-court-muted font-display">
          {m.awayTeamName?.charAt(0) ?? "?"}
        </div>
      )}
      <span class="text-xs font-semibold text-white truncate w-full">{m.awayTeamName ?? "TBD"}</span>
    </div>
  </div>
</div>
