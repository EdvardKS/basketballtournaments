---
import { STATUS_LABEL, STATUS_COLOR } from "../lib/display.js";
import type { Tournament } from "../lib/types.js";
interface Props { tournament: Tournament; }
const { tournament: t } = Astro.props;
---
<header class="mb-6">
  <div class="flex flex-wrap items-baseline gap-3 mb-2">
    <h1 class="text-5xl text-court-accent">{t.name}</h1>
    <span class={`chip ${STATUS_COLOR[t.status]}`}>{STATUS_LABEL[t.status]}</span>
  </div>
  <dl class="grid sm:grid-cols-3 gap-4 text-sm text-slate-300">
    <div><dt class="text-slate-500 text-xs uppercase">Fecha</dt><dd>{t.date}</dd></div>
    <div><dt class="text-slate-500 text-xs uppercase">Sede</dt><dd>{t.location}</dd></div>
    <div><dt class="text-slate-500 text-xs uppercase">Plazas</dt><dd>{t.maxTeams} equipos</dd></div>
  </dl>
  <p class="mt-4 text-slate-200">{t.description}</p>
  {t.rules && (
    <details class="mt-4">
      <summary class="cursor-pointer text-xs uppercase tracking-wider text-court-accent">
        Reglas
      </summary>
      <pre class="mt-2 text-xs text-slate-400 whitespace-pre-wrap font-body">{t.rules}</pre>
    </details>
  )}
</header>
