---
import type { Tournament } from "../../lib/types.js";
import Countdown from "../../islands/landing/Countdown.js";

interface Props {
  active: Tournament | null;
  spotsLeft: number;
  primaryCtaHref: string;
}
const { active, spotsLeft, primaryCtaHref } = Astro.props;

const hasOpenSlots = active && spotsLeft > 0;
const target = active?.inscriptionEnd ?? active?.matchDate ?? active?.date ?? null;
---
<section class="relative overflow-hidden">
  {hasOpenSlots ? (
    <div
      class="relative animate-gradient-shift"
      style="background: linear-gradient(120deg, #ff2d2d 0%, #ff6b00 50%, #ff2d2d 100%);"
    >
      <div class="absolute inset-0 opacity-20 mix-blend-overlay" aria-hidden="true">
        <svg class="w-full h-full" viewBox="0 0 800 200" preserveAspectRatio="none">
          <line x1="400" y1="0" x2="400" y2="200" stroke="#fff" stroke-width="2" />
          <circle cx="400" cy="100" r="50" fill="none" stroke="#fff" stroke-width="2" />
        </svg>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 py-12 sm:py-14 flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="flex-1 min-w-0">
          <p class="text-[10px] sm:text-xs uppercase tracking-[0.4em] text-white/80 mb-2">Última llamada</p>
          <p class="font-hero text-white leading-[0.9]" style="font-size: clamp(2rem, 5vw, 3.75rem);">
            QUEDAN <span class="text-white" style="text-shadow: 0 0 18px rgba(255,255,255,0.7);">{spotsLeft}</span> {spotsLeft === 1 ? "PLAZA" : "PLAZAS"}
          </p>
          <p class="mt-2 text-white/85 text-sm sm:text-base">
            Reserva la tuya antes del cierre de inscripciones.
          </p>
        </div>

        {target && (
          <div class="shrink-0">
            <Countdown client:visible targetIso={target} label="Cierre" variant="orange" />
          </div>
        )}

        <a
          href={primaryCtaHref}
          class="shrink-0 inline-flex items-center justify-center gap-2 px-8 py-4 rounded-lg bg-white text-[var(--color-neon-red)] font-bold uppercase tracking-wider hover:scale-105 transition-transform shadow-[0_0_40px_rgba(255,255,255,0.6)]"
        >
          Apuntarme ya
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  ) : (
    <div class="bg-court-card/60 border-y border-white/5">
      <div class="max-w-7xl mx-auto px-4 py-12 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
        <div>
          <p class="text-[10px] uppercase tracking-[0.4em] text-[var(--color-neon-blue)] mb-2">Próximamente</p>
          <p class="font-hero text-white text-3xl sm:text-4xl leading-none">
            ¿Te perdiste este torneo?
          </p>
          <p class="mt-2 text-court-muted text-sm">
            Regístrate ahora y entra automáticamente al próximo draft.
          </p>
        </div>
        <a href="/register" class="btn-neon-blue">Lista de espera</a>
      </div>
    </div>
  )}
</section>
