---
import type { TournamentStatus } from "../../lib/types.js";
import type { TournamentPhase } from "../../lib/tournamentPhase.js";
import { formatDate } from "../../lib/display.js";

interface Props {
  status?: TournamentStatus;   // legacy entry-point (landing page uses this)
  phase?: TournamentPhase;     // preferred — derives directly without remapping
  matchDate?: string | null;   // shown under the "Grupos" step
}
const { status, phase, matchDate } = Astro.props;

// 5 visible steps. We map a "current step index" from either signal.
const STEPS: { label: string; icon: string }[] = [
  { label: "Inscripción",   icon: "M12 5v14M5 12h14" },
  { label: "Draft",         icon: "M3 6h18M3 12h12M3 18h18" },
  { label: "Grupos",        icon: "M4 6h6v6H4zM14 6h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" },
  { label: "Eliminatorias", icon: "M6 4v16M18 4v16M6 12h12" },
  { label: "Final",         icon: "M8 21h8M12 17v4M7 4h10v6a5 5 0 01-10 0V4z" },
];

// Fractional positions so preMatchday lands halfway between Draft (1) and
// Grupos (2). Lookup returns a number where the integer part is the active
// step and the fractional part offsets the connector bar.
const phaseToFloat = (p: TournamentPhase): number => {
  if (p === "pre")         return 0;
  if (p === "draft")       return 1;
  if (p === "preMatchday") return 1.5;
  if (p === "groups")      return 2;
  if (p === "knockouts")   return 3;
  return 4; // completed
};

const statusToIdx = (s: TournamentStatus): number => {
  if (s === "upcoming" || s === "open") return 0;
  if (s === "draft")                    return 1;
  if (s === "setup" || s === "scheduled") return 2;
  if (s === "active")                   return 3;
  return 4; // completed
};

const currentIdx = phase ? phaseToFloat(phase) : status ? statusToIdx(status) : 0;
const inBetween = currentIdx % 1 !== 0;

const stateOf = (i: number): "done" | "active" | "pending" => {
  if (inBetween) return i <= Math.floor(currentIdx) ? "done" : "pending";
  return i < currentIdx ? "done" : i === currentIdx ? "active" : "pending";
};

// Progress fill: dot-centred on the active step (or floating between steps
// when inBetween).
const fillPct = Math.min(100, Math.max(0, ((currentIdx + 0.5) / STEPS.length) * 100));
const dateLabel = matchDate ? formatDate(matchDate) : null;
---
<div class="w-full">
  <div class="relative">
    <div class="absolute top-5 left-5 right-5 h-1 bg-white/10 rounded-full" aria-hidden="true" />
    <div
      class="absolute top-5 left-5 h-1 rounded-full"
      style={`width: calc((100% - 2.5rem) * ${fillPct} / 100); background: linear-gradient(90deg, #ff6b00, #ff2d2d); box-shadow: 0 0 12px rgba(255,107,0,0.7); animation: progress-fill 1.4s cubic-bezier(.2,.8,.2,1) both; --progress: ${fillPct}%;`}
      aria-hidden="true"
    />

    <ol class="relative flex items-start justify-between gap-1">
      {STEPS.map((p, i) => {
        const state = stateOf(i);
        const showDate = i === 2 && dateLabel; // under "Grupos"
        return (
          <li class="flex flex-col items-center gap-2 flex-1 min-w-0">
            <div
              class:list={[
                "w-10 h-10 rounded-full flex items-center justify-center border-2 transition-all relative z-10",
                state === "done" && "bg-[var(--color-neon-orange)] border-[var(--color-neon-orange)] text-white",
                state === "active" && "bg-court-dark border-[var(--color-neon-orange)] text-[var(--color-neon-orange)] animate-glow",
                state === "pending" && "bg-court-dark border-white/15 text-white/30",
              ]}
              style={`animation-delay: ${i * 120}ms;`}
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={p.icon} />
              </svg>
            </div>
            <span
              class:list={[
                "text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-center",
                state === "done" && "text-[var(--color-neon-orange)]",
                state === "active" && "text-white",
                state === "pending" && "text-white/30",
              ]}
            >
              {p.label}
            </span>
            {showDate && (
              <span class="text-[10px] tabular-nums text-court-muted text-center">
                {dateLabel}
              </span>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</div>
