---
const STEPS = [
  {
    n: "01",
    title: "Inscripción",
    desc: "Regístrate y deja tu posición. Sin equipo previo: jugadores libres.",
    icon: "M12 5v14M5 12h14",
    color: "var(--color-neon-orange)",
  },
  {
    n: "02",
    title: "Draft",
    desc: "Los capitanes eligen por turnos en directo. Forma tu plantilla.",
    icon: "M3 6h13M3 12h9M3 18h13M17 8l4 4-4 4",
    color: "var(--color-neon-blue)",
  },
  {
    n: "03",
    title: "Grupos",
    desc: "Liguilla rápida 3×3. Todos los equipos juegan, todos puntúan.",
    icon: "M4 6h6v6H4zM14 6h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z",
    color: "var(--color-neon-orange)",
  },
  {
    n: "04",
    title: "Eliminatorias",
    desc: "Cuartos, semis y bronce. A partir de aquí no hay margen de error.",
    icon: "M6 4v6a3 3 0 003 3h6a3 3 0 003-3V4M6 14v6M18 14v6M6 20h12",
    color: "var(--color-neon-red)",
  },
  {
    n: "05",
    title: "Final",
    desc: "Una cancha. Dos equipos. Un campeón. Trofeo y leyenda.",
    icon: "M8 21h8M12 17v4M5 4h14v5a7 7 0 01-14 0V4z",
    color: "#f5c518",
  },
];
---
<section class="relative max-w-7xl mx-auto px-4 py-24 sm:py-32">
  <div class="text-center mb-16">
    <p class="text-[11px] uppercase tracking-[0.4em] text-[var(--color-neon-orange)] font-semibold mb-3">Cómo funciona</p>
    <h2 class="font-hero text-5xl sm:text-7xl text-white leading-none">
      DEL PRIMER PIQUE<br/>
      <span class="text-neon-orange">A LA FINAL</span>
    </h2>
    <p class="mt-4 text-court-muted max-w-2xl mx-auto">
      Cinco fases. Una experiencia de torneo de verdad, sin enchufes y sin esperas.
    </p>
  </div>

  <div class="relative">
    <!-- Connector line desktop -->
    <div class="hidden md:block absolute top-12 left-12 right-12 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent" aria-hidden="true" />

    <ol class="grid grid-cols-1 md:grid-cols-5 gap-6">
      {STEPS.map((s, i) => (
        <li
          class="relative group animate-slide-up"
          style={`animation-delay: ${i * 120}ms;`}
        >
          <div
            class="relative h-full rounded-2xl p-6 border border-white/5 bg-court-card/60 backdrop-blur-sm transition-all duration-300 group-hover:-translate-y-2 group-hover:border-white/20 overflow-hidden"
            style={`--accent: ${s.color};`}
          >
            <!-- Glow on hover -->
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
              style={`background: radial-gradient(circle at 50% 0%, ${s.color}30, transparent 70%);`}
              aria-hidden="true"
            />
            <!-- Big background number -->
            <span
              class="absolute -top-4 -right-2 font-hero text-[7rem] leading-none text-white/[0.04] select-none pointer-events-none"
              aria-hidden="true"
            >{s.n}</span>

            <div class="relative">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center mb-4 border"
                style={`background: ${s.color}1A; border-color: ${s.color}66; color: ${s.color}; box-shadow: 0 0 18px ${s.color}55;`}
              >
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={s.icon} />
                </svg>
              </div>
              <p class="text-[10px] uppercase tracking-[0.25em] text-court-muted mb-1">Paso {s.n}</p>
              <h3 class="font-hero text-2xl text-white mb-2 leading-none">{s.title}</h3>
              <p class="text-sm text-court-muted leading-relaxed">{s.desc}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
