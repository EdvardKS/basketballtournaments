---
interface Match {
  id: string; stage: string; status: string;
  homeTeamId: string | null; awayTeamId: string | null;
  homeScore: number | null; awayScore: number | null;
  winnerId: string | null;
}
interface TeamInfo { id: string; name: string; }
interface Props { matches: Match[]; teams: TeamInfo[]; }
const { matches, teams } = Astro.props;
const nameOf = (id: string | null) =>
  id ? teams.find((t) => t.id === id)?.name ?? "?" : "—";
const statusColor = (s: string) => s === "completed" ? "text-court-ok"
  : s === "in_progress" ? "text-court-accent" : "text-slate-500";
---

{matches.length === 0 ? (
  <p class="text-slate-500 text-sm">Sin partidos todavía.</p>
) : (
  <ul class="space-y-2">
    {matches.map((m) => (
      <li class="card py-3 flex items-center gap-3 text-sm">
        <span class="chip">{m.stage}</span>
        <span class={`flex-1 ${m.winnerId === m.homeTeamId ? "font-semibold text-court-accent" : ""}`}>
          {nameOf(m.homeTeamId)}
        </span>
        <span class="font-display text-2xl tabular-nums">
          {m.homeScore ?? "-"} : {m.awayScore ?? "-"}
        </span>
        <span class={`flex-1 text-right ${m.winnerId === m.awayTeamId ? "font-semibold text-court-accent" : ""}`}>
          {nameOf(m.awayTeamId)}
        </span>
        <span class={`chip ${statusColor(m.status)}`}>{m.status}</span>
      </li>
    ))}
  </ul>
)}
