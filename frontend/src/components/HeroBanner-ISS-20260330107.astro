---
// Hero NBA-style con imagen de fondo oscura y título gigante.
interface Props { hasActive: boolean; activeName?: string; }
const { hasActive, activeName } = Astro.props;
---
<section class="relative overflow-hidden rounded-2xl mb-14 border border-slate-800">
  <div class="absolute inset-0 bg-cover bg-center"
       style="background-image:url('/img/court-bg.png');"></div>
  <div class="absolute inset-0"
       style="background:linear-gradient(180deg,rgba(11,15,26,.55),rgba(11,15,26,.95));"></div>

  <div class="relative px-6 md:px-14 py-16 md:py-24 text-center">
    <span class="inline-block chip bg-court-accent/20 text-court-accent mb-4 tracking-[0.3em]">
      VILLENA · 2026 SEASON
    </span>
    <h1 class="font-display text-6xl md:text-8xl leading-[0.9] uppercase tracking-wider
               bg-gradient-to-br from-white via-slate-200 to-court-accent
               bg-clip-text text-transparent drop-shadow-[0_4px_24px_rgba(0,0,0,0.6)]">
      Villena <br class="md:hidden" />Basket League
    </h1>
    <p class="mt-5 max-w-2xl mx-auto text-slate-300 text-base md:text-lg">
      La liga amateur oficial de Villena. Inscríbete, sigue el draft en directo,
      vive los playoffs y conserva tu carta con estadísticas temporada tras temporada.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {hasActive ? (
        <a href="#active-tournament" class="btn-primary">
          Ver {activeName ?? "el torneo en curso"} →
        </a>
      ) : (
        <a href="/login" class="btn-ghost">Entrar al panel</a>
      )}
      <a href="/docs" class="btn-ghost">Cómo funciona</a>
    </div>

    <div class="mt-10 grid grid-cols-3 gap-4 text-center max-w-xl mx-auto">
      <div><div class="font-display text-3xl text-court-accent">5v5</div>
        <div class="text-xs uppercase tracking-wider text-slate-400">Formato FIBA</div></div>
      <div><div class="font-display text-3xl text-court-accent">Draft</div>
        <div class="text-xs uppercase tracking-wider text-slate-400">Por capitanes</div></div>
      <div><div class="font-display text-3xl text-court-accent">Live</div>
        <div class="text-xs uppercase tracking-wider text-slate-400">Marcadores en vivo</div></div>
    </div>
  </div>
</section>
