---
import type { Player } from "../lib/types.js";
import { POSITION_LABEL, overallColor } from "../lib/display.js";

interface Props {
  player: Player;
  authenticated?: boolean;
  showContact?: boolean;
}
const { player: p, authenticated = false, showContact = false } = Astro.props;
const displayName = authenticated ? p.name : p.name.charAt(0) + "***";
---
<div class="card flex gap-3 animate-flip-card hover:border-court-accent/40 transition-colors">
  <!-- Avatar -->
  <div class="shrink-0">
    {p.avatar ? (
      <img src={p.avatar} alt={displayName} class="w-14 h-14 rounded-xl object-cover border border-court-border" />
    ) : (
      <div class="w-14 h-14 rounded-xl bg-court-border flex items-center justify-center text-2xl text-court-muted">
        {authenticated ? p.name.charAt(0) : "?"}
      </div>
    )}
  </div>

  <!-- Info -->
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-1">
      <p class="font-semibold text-white text-sm truncate">{displayName}</p>
      <span class:list={["font-display text-xl font-bold shrink-0", overallColor(p.overall)]}>
        {p.overall}
      </span>
    </div>
    <p class="text-xs text-court-muted">{POSITION_LABEL[p.position] ?? p.position}</p>
    {p.age && <p class="text-xs text-court-muted">{p.age} años</p>}

    {showContact && authenticated && (
      <div class="flex gap-2 mt-2 flex-wrap">
        {p.mobile && (
          <a href={`tel:${p.mobile}`} class="text-[10px] text-court-accent hover:underline">{p.mobile}</a>
        )}
        {p.email && (
          <a href={`mailto:${p.email}`} class="text-[10px] text-court-muted hover:text-white hover:underline truncate max-w-[120px]">{p.email}</a>
        )}
      </div>
    )}
  </div>
</div>
