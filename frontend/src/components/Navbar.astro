---
import type { Player } from "../lib/types.js";

interface Props { player?: Player | null }
const { player } = Astro.props;
const role = player?.role;

const dashLink = role === "admin" ? "/dashboard/admin"
  : role === "captain" ? "/dashboard/captain"
  : "/dashboard/player";

const ROLE_COLOR: Record<string, string> = {
  admin:   "chip bg-court-danger/20 text-court-danger",
  captain: "chip bg-court-gold/20 text-court-gold",
  player:  "chip bg-court-ok/20 text-court-ok",
};
const ROLE_LABEL: Record<string, string> = {
  admin: "Admin", captain: "Capitán", player: "Jugador",
};
---
<header class="sticky top-0 z-50 border-b border-court-border bg-court-dark/90 backdrop-blur-md">
  <nav class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <div class="w-8 h-8 rounded-full bg-court-accent flex items-center justify-center text-white font-display font-bold text-lg leading-none">V</div>
      <span class="font-display text-xl font-semibold tracking-wide hidden sm:block">VBL</span>
    </a>

    <!-- Center nav -->
    <div class="flex items-center gap-1">
      <a href="/" class="btn-ghost text-xs px-3 py-1.5">Inicio</a>
      <a href="/docs" class="btn-ghost text-xs px-3 py-1.5">Bases</a>
    </div>

    <!-- Auth -->
    <div class="flex items-center gap-2 shrink-0">
      {player ? (
        <>
          {role && <span class={ROLE_COLOR[role]}>{ROLE_LABEL[role]}</span>}
          <a href={dashLink} class="btn-ghost text-xs px-3 py-1.5">Mi Panel</a>
          <button id="btn-logout" type="button" class="btn-ghost text-xs px-3 py-1.5 text-court-danger border-court-danger/30">
            Salir
          </button>
          <script>
            document.getElementById("btn-logout")?.addEventListener("click", async () => {
              await fetch("/api/auth/logout", { method: "POST", credentials: "include" }).catch(() => {});
              window.location.href = "/";
            });
          </script>
        </>
      ) : (
        <>
          <a href="/login" class="btn-ghost text-xs px-3 py-1.5">Iniciar sesión</a>
          <a href="/register" class="btn-primary text-xs px-3 py-1.5">Registrarse</a>
        </>
      )}
    </div>
  </nav>
</header>
