---
import type { Tournament } from "../lib/types.js";
import { formatDate } from "../lib/display.js";

interface Props { tournaments: Tournament[] }
const { tournaments } = Astro.props;
const completed = tournaments.filter((t) => t.status === "completed");
---
{completed.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="font-display text-3xl text-white mb-6">Historial de torneos</h2>

    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-3 top-0 bottom-0 w-0.5 bg-court-border" />

      <ul class="space-y-6 pl-10">
        {completed.map((t) => (
          <li class="relative animate-slide-in">
            <!-- Dot -->
            <div class="absolute -left-7 top-2 w-3 h-3 rounded-full border-2 border-court-accent bg-court-dark" />

            <a href={`/tournaments/${t.id}`} class="block card hover:border-court-accent/40 transition-colors group">
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <div>
                  <p class="text-xs text-court-muted mb-0.5">{formatDate(t.matchDate ?? t.date)}</p>
                  <h3 class="font-display text-xl text-white group-hover:text-court-accent transition-colors">{t.name}</h3>
                  <p class="text-xs text-court-muted">{t.location}</p>
                </div>
                {t.winnerId && (
                  <div class="text-right">
                    <p class="text-xs text-court-muted">Campeón</p>
                    <span class="chip bg-court-gold/20 text-court-gold">🏆 Registrado</span>
                  </div>
                )}
              </div>
              <p class="text-sm text-court-muted mt-2 line-clamp-1">{t.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
