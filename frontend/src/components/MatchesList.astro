---
import type { Match } from "../lib/types.js";
import MatchCard from "./MatchCard.astro";

interface Props { matches: Match[]; hoursConfirmed?: boolean; groupId?: string | null }
const { matches, hoursConfirmed = false, groupId = null } = Astro.props;

// When a groupId is passed, narrow to that single group's matches before
// stage-grouping. Lets GroupCard reuse this list filtered to its own group.
const filtered: Match[] = groupId ? matches.filter((m: Match) => m.groupId === groupId) : matches;

const byStage = filtered.reduce<Record<string, Match[]>>((acc: Record<string, Match[]>, m: Match) => {
  const key = m.stage; (acc[key] ??= []).push(m); return acc;
}, {});

const STAGE_LABEL: Record<string, string> = {
  group: "Fase de grupos", quarterfinal: "Cuartos de final",
  semifinal: "Semifinales", final: "Final",
  third_place: "3er y 4to puesto",
};
const STAGE_ORDER = ["group","quarterfinal","semifinal","third_place","final"];
---
{Object.keys(byStage).length > 0 ? (
  <div class="space-y-8">
    {STAGE_ORDER.filter((s) => byStage[s]).map((stage) => (
      <div>
        <h3 class="font-display text-xl text-white mb-3">{STAGE_LABEL[stage] ?? stage}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {byStage[stage].map((m: Match) => (
            <MatchCard match={m} hoursConfirmed={hoursConfirmed} />
          ))}
        </div>
      </div>
    ))}
  </div>
) : (
  <div class="card text-center py-8">
    <p class="text-court-muted text-sm">Los partidos aparecerán aquí cuando estén programados</p>
  </div>
)}
