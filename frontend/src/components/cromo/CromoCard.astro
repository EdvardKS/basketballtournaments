---
import type { Player, Achievement } from "../../lib/types.js";
import { cromoTier, tierTheme, POSITION_ABBR } from "../../lib/cromo.js";
import { overallColor } from "../../lib/display.js";

interface Props { player: Player; achievements?: Achievement[] }
const { player: p } = Astro.props as Props;
const tier = cromoTier(p.createdAt);
const theme = tierTheme(tier);
const positionAbbr = POSITION_ABBR[p.position] ?? p.position.slice(0, 2).toUpperCase();

const stats = [
  ["RIT", p.pace], ["TIR", p.shooting], ["PAS", p.passing],
  ["REG", p.dribbling], ["DEF", p.defense], ["FIS", p.physical],
] as const;
---
<div id="cromo-root" class:list={["cromo", theme.frameClass]}>
  <div class="cromo-bg" aria-hidden="true"></div>
  <div class="cromo-shine" aria-hidden="true"></div>

  <!-- Top-left: overall + position -->
  <div class="cromo-corner">
    <div class:list={["cromo-overall", overallColor(p.overall)]}>{p.overall}</div>
    <div class="cromo-position">{positionAbbr}</div>
    <div class="cromo-divider"></div>
  </div>

  <!-- Tier badge top-right -->
  <div class="cromo-tier">{theme.tierLabel}</div>

  <!-- Avatar (cut-out, transparent) -->
  <div class="cromo-photo">
    {p.avatar ? (
      <img src={p.avatar} alt="" />
    ) : (
      <div class="cromo-photo-fallback">{p.name.charAt(0).toUpperCase()}</div>
    )}
  </div>

  <!-- Footer: divider, name, stats -->
  <div class="cromo-footer">
    <div class="cromo-divider-line" aria-hidden="true"></div>
    <p class="cromo-name">{p.name}</p>
    <div class="cromo-stats">
      {stats.map(([k, v]) => (
        <div class="cromo-stat">
          <span class="cromo-stat-val">{v}</span>
          <span class="cromo-stat-key">{k}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .cromo {
    position: relative;
    width: clamp(260px, 86vw, 340px);
    margin: 0 auto;
    aspect-ratio: 3 / 4;
    border-radius: 22px;
    overflow: hidden;
    isolation: isolate;
    color: white;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 22px 50px -12px rgba(0, 0, 0, 0.65),
      0 0 50px -10px var(--cromo-glow, transparent);
  }

  /* Background gradient + tier glow + subtle vertical court-line texture */
  .cromo-bg {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 50% 0%, var(--cromo-c2) 0%, transparent 55%),
      radial-gradient(ellipse at 50% 100%, var(--cromo-c2) 0%, transparent 60%),
      linear-gradient(160deg, var(--cromo-c1) 0%, var(--cromo-c3) 100%);
    z-index: 0;
  }
  .cromo-bg::after {
    content: "";
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      105deg,
      transparent 0 22px,
      rgba(255, 255, 255, 0.035) 22px 24px
    );
    pointer-events: none;
  }
  .cromo-shine {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 25% 110%, rgba(255,255,255,0.20), transparent 55%);
    mix-blend-mode: screen;
    z-index: 1;
    pointer-events: none;
  }

  /* --- Top corners --- */
  .cromo-corner {
    position: absolute; top: 18px; left: 22px; z-index: 3;
    display: flex; flex-direction: column; align-items: center;
    gap: 4px;
  }
  .cromo-overall {
    font-family: var(--font-display, "Bebas Neue", sans-serif);
    font-size: 64px;
    line-height: 0.82;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-shadow: 0 3px 14px rgba(0,0,0,0.55);
  }
  .cromo-position {
    font-family: var(--font-display, "Bebas Neue", sans-serif);
    font-size: 18px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.95);
    margin-top: 4px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.55);
  }
  .cromo-divider {
    width: 30px; height: 2px;
    background: linear-gradient(90deg, transparent, currentColor, transparent);
    opacity: 0.55;
    margin-top: 4px;
  }

  .cromo-tier {
    position: absolute; top: 18px; right: 18px; z-index: 3;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.3em;
    padding: 5px 10px;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 999px;
    background: rgba(0,0,0,0.28);
    backdrop-filter: blur(4px);
    text-transform: uppercase;
  }

  /* --- Avatar area (cut-out person on gradient, no card behind) --- */
  .cromo-photo {
    position: absolute;
    top: 13%;
    left: 50%;
    transform: translateX(-50%);
    width: 64%;
    aspect-ratio: 1;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .cromo-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter:
      drop-shadow(0 18px 22px rgba(0, 0, 0, 0.55))
      drop-shadow(0 0 4px rgba(0, 0, 0, 0.4));
  }
  .cromo-photo-fallback {
    width: 76%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display, "Bebas Neue", sans-serif);
    font-size: 88px; color: rgba(255,255,255,0.55);
  }

  /* --- Footer band: divider line, name, stats grid --- */
  .cromo-footer {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 14px 20px 22px;
    z-index: 3;
    background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.30) 30%, rgba(0,0,0,0.72) 100%);
  }
  .cromo-divider-line {
    width: 70%;
    height: 1px;
    margin: 0 auto 14px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
  }
  .cromo-name {
    font-family: var(--font-display, "Bebas Neue", sans-serif);
    font-size: 22px;
    line-height: 1;
    letter-spacing: 0.05em;
    text-align: center;
    margin: 0 0 14px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.55);
    text-transform: uppercase;
    color: #fff;
  }
  .cromo-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px 8px;
  }
  .cromo-stat {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 5px;
    padding: 6px 4px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 8px;
    font-family: var(--font-display, "Bebas Neue", sans-serif);
  }
  .cromo-stat-val {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    line-height: 1;
  }
  .cromo-stat-key {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.7);
  }

  /* --- Tier palettes (one per year) --- */
  .frame-v1 {
    --cromo-c1: #4a4035;
    --cromo-c2: #c08a4b;
    --cromo-c3: #1c150f;
    --cromo-glow: rgba(192, 138, 75, 0.45);
  }
  .frame-v2 {
    --cromo-c1: #2a3450;
    --cromo-c2: #7c8aae;
    --cromo-c3: #0d1422;
    --cromo-glow: rgba(124, 138, 174, 0.45);
  }
  .frame-v3 {
    --cromo-c1: #563a0c;
    --cromo-c2: #f5c518;
    --cromo-c3: #1a1206;
    --cromo-glow: rgba(245, 197, 24, 0.55);
  }
  .frame-v4 {
    --cromo-c1: #0d3a2b;
    --cromo-c2: #16d39b;
    --cromo-c3: #04150f;
    --cromo-glow: rgba(22, 211, 155, 0.5);
  }
  .frame-v5\+ {
    --cromo-c1: #2a0d5a;
    --cromo-c2: #d34ce0;
    --cromo-c3: #07041a;
    --cromo-glow: rgba(211, 76, 224, 0.55);
  }
</style>
