---
// Single source of truth for the cromo visual. The card is always rendered
// at the canonical pixel size (680×906); the surrounding `.cromo-fit`
// wrapper uses a CSS container query to scale it down for the preview.
// `lib/cromo-export.ts` clones #cromo-root into an off-screen sandbox at
// the same pixel dimensions when the user shares — that's why we keep
// every measurement in absolute px and avoid `clamp` / `vw` / aspect-ratio
// inside the card itself.
import type { Player, Achievement } from "../../lib/types.js";
import { cromoTier, tierTheme, POSITION_ABBR } from "../../lib/cromo.js";
import { overallColor } from "../../lib/display.js";

interface Props { player: Player; achievements?: Achievement[] }
const { player: p } = Astro.props as Props;
const tier = cromoTier(p.createdAt);
const theme = tierTheme(tier);
const positionAbbr = POSITION_ABBR[p.position] ?? p.position.slice(0, 2).toUpperCase();

const stats = [
  ["RIT", p.pace], ["TIR", p.shooting], ["PAS", p.passing],
  ["REG", p.dribbling], ["DEF", p.defense], ["FIS", p.physical],
] as const;
---
<div class="cromo-fit">
  <div id="cromo-root" class:list={["cromo", theme.frameClass]}>
    <!-- Layered background: vignette + metallic gradient + diagonal texture + radial spotlight -->
    <div class="cromo-bg" aria-hidden="true"></div>
    <div class="cromo-texture" aria-hidden="true"></div>
    <div class="cromo-spotlight" aria-hidden="true"></div>
    <div class="cromo-vignette" aria-hidden="true"></div>

    <!-- Outer metallic frame -->
    <div class="cromo-frame" aria-hidden="true"></div>

    <!-- Top-left: rating + position -->
    <div class="cromo-corner">
      <div class:list={["cromo-overall", overallColor(p.overall)]}>{p.overall}</div>
      <div class="cromo-divider" aria-hidden="true"></div>
      <div class="cromo-position">{positionAbbr}</div>
    </div>

    <!-- Tier badge top-right -->
    <div class="cromo-tier">
      <span class="cromo-tier-dot" aria-hidden="true"></span>
      {theme.tierLabel}
    </div>

    <!-- Avatar zone — radial halo + cut-out photo -->
    <div class="cromo-photo-halo" aria-hidden="true"></div>
    <div class="cromo-photo">
      {p.avatar ? (
        <img src={p.avatar} alt="" crossorigin="anonymous" decoding="sync" />
      ) : (
        <div class="cromo-photo-fallback">{p.name.charAt(0).toUpperCase()}</div>
      )}
    </div>

    <!-- Footer: brand line, name, stats grid -->
    <div class="cromo-footer">
      <div class="cromo-brand" aria-hidden="true">
        <span class="cromo-brand-dot"></span>
        <span class="cromo-brand-text">VBL · VILLENA BASKET LEAGUE</span>
        <span class="cromo-brand-dot"></span>
      </div>
      <p class="cromo-name">{p.name}</p>
      <div class="cromo-stats">
        {stats.map(([k, v]) => (
          <div class="cromo-stat">
            <span class="cromo-stat-val">{v}</span>
            <span class="cromo-stat-key">{k}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* --- Preview-scale wrapper. The inner card stays at 680×906 px logical
         (the same pixel box exportCardToPng captures). Container queries
         scale the visual via transform; the box reserved in the layout
         shrinks via aspect-ratio so the surrounding column collapses. --- */
  .cromo-fit {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    aspect-ratio: 680 / 906;
    container-type: inline-size;
    position: relative;
    overflow: visible;
  }
  .cromo-fit .cromo {
    position: absolute;
    top: 0; left: 0;
    width: 680px;
    height: 906px;
    transform-origin: top left;
    transform: scale(calc(100cqw / 680));
  }

  /* --- Canonical card box. Absolute px everywhere — no clamp / vw / %. --- */
  .cromo {
    border-radius: 32px;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    font-family: var(--font-display, "Bebas Neue", "Inter", sans-serif);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.06) inset,
      0 36px 80px -28px rgba(0,0,0,0.85),
      0 0 80px -20px var(--cromo-glow, transparent);
  }

  /* Metallic outer frame — plain solid border so html2canvas renders it 1:1.
     The dual-tone metallic feel comes from the inset highlight + outer
     glow below, not from a CSS mask (which html2canvas can't reproduce). */
  .cromo-frame {
    position: absolute;
    inset: 6px;
    border-radius: 26px;
    border: 2px solid var(--cromo-frame-2);
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.07),
      inset 0 1px 0 rgba(255,255,255,0.12),
      0 0 30px -8px var(--cromo-glow);
    pointer-events: none;
    z-index: 4;
  }

  .cromo-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 30%, var(--cromo-c2) 0%, transparent 60%),
      linear-gradient(170deg, var(--cromo-c1) 0%, var(--cromo-c3) 55%, #06080f 100%);
  }
  .cromo-texture {
    position: absolute; inset: 0; z-index: 0;
    background:
      repeating-linear-gradient(115deg,
        transparent 0 36px,
        rgba(255,255,255,0.045) 36px 38px,
        transparent 38px 80px,
        rgba(255,255,255,0.025) 80px 82px),
      repeating-linear-gradient(65deg,
        transparent 0 60px,
        rgba(0,0,0,0.08) 60px 62px);
    opacity: 0.95;
    pointer-events: none;
  }
  .cromo-spotlight {
    position: absolute; inset: 0; z-index: 1;
    background: radial-gradient(ellipse 70% 50% at 50% 38%, rgba(255,255,255,0.22), transparent 65%);
    pointer-events: none;
  }
  .cromo-vignette {
    position: absolute; inset: 0; z-index: 5;
    background:
      radial-gradient(ellipse 110% 110% at 50% 50%, transparent 55%, rgba(0,0,0,0.55) 100%);
    pointer-events: none;
  }

  /* --- Top-left corner: overall + divider + position --- */
  .cromo-corner {
    position: absolute;
    top: 36px;
    left: 44px;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cromo-overall {
    font-size: 104px;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-shadow:
      0 4px 22px rgba(0,0,0,0.65),
      0 1px 0 rgba(255,255,255,0.08);
  }
  .cromo-divider {
    width: 56px; height: 3px;
    margin: 10px 0 6px;
    background: linear-gradient(90deg, transparent, currentColor 35%, currentColor 65%, transparent);
    opacity: 0.55;
  }
  .cromo-position {
    font-size: 30px;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.95);
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }

  /* --- Tier badge --- */
  .cromo-tier {
    position: absolute;
    top: 42px;
    right: 44px;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--cromo-tier-text, #fff);
    background:
      linear-gradient(180deg, rgba(0,0,0,0.55), rgba(0,0,0,0.3)),
      var(--cromo-tier-bg, rgba(0,0,0,0.5));
    border: 1px solid var(--cromo-frame-2);
    box-shadow:
      0 4px 14px rgba(0,0,0,0.45),
      inset 0 1px 0 rgba(255,255,255,0.15);
  }
  .cromo-tier-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--cromo-frame-2);
    box-shadow: 0 0 10px var(--cromo-frame-2);
  }

  /* --- Avatar zone --- */
  .cromo-photo-halo {
    position: absolute;
    top: 100px;
    left: 50%;
    transform: translateX(-50%);
    width: 540px;
    height: 540px;
    z-index: 1;
    background: radial-gradient(circle at 50% 45%, var(--cromo-c2) 0%, transparent 55%);
    opacity: 0.55;
    pointer-events: none;
    filter: blur(4px);
  }
  .cromo-photo {
    position: absolute;
    top: 90px;
    left: 50%;
    transform: translateX(-50%);
    width: 480px;
    height: 510px;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .cromo-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter:
      drop-shadow(0 36px 36px rgba(0,0,0,0.55))
      drop-shadow(0 0 10px rgba(0,0,0,0.4));
  }
  .cromo-photo-fallback {
    width: 360px; height: 360px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    font-size: 180px;
    color: rgba(255,255,255,0.45);
  }

  /* --- Footer: brand + name + stats --- */
  .cromo-footer {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 28px 44px 36px;
    z-index: 6;
    background: linear-gradient(180deg,
      transparent 0%,
      rgba(0,0,0,0.10) 25%,
      rgba(0,0,0,0.55) 60%,
      rgba(0,0,0,0.92) 100%);
  }
  .cromo-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .cromo-brand-text {
    font-size: 11px;
    letter-spacing: 0.4em;
    color: rgba(255,255,255,0.55);
  }
  .cromo-brand-dot {
    width: 56px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
  }
  .cromo-name {
    font-size: 44px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-align: center;
    margin: 0 0 22px;
    text-shadow:
      0 4px 18px rgba(0,0,0,0.55),
      0 1px 0 rgba(255,255,255,0.1);
    text-transform: uppercase;
    color: #fff;
    font-weight: 800;
  }
  .cromo-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px 10px;
  }
  .cromo-stat {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 8px;
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.10);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.08),
      0 2px 6px rgba(0,0,0,0.35);
  }
  .cromo-stat-val {
    font-size: 36px;
    font-weight: 800;
    color: #fff;
    line-height: 1;
    text-shadow: 0 2px 6px rgba(0,0,0,0.5);
  }
  .cromo-stat-key {
    font-size: 13px;
    letter-spacing: 0.24em;
    color: rgba(255,255,255,0.65);
  }

  /* --- Tier palettes --- */
  .frame-v1 {
    --cromo-c1: #5a4a3a;
    --cromo-c2: #d4a05c;
    --cromo-c3: #1a120c;
    --cromo-glow: rgba(212, 160, 92, 0.45);
    --cromo-frame-1: rgba(212, 160, 92, 0.85);
    --cromo-frame-2: #f0c987;
    --cromo-tier-text: #f0c987;
  }
  .frame-v2 {
    --cromo-c1: #2b3858;
    --cromo-c2: #98abdd;
    --cromo-c3: #0b1224;
    --cromo-glow: rgba(152, 171, 221, 0.5);
    --cromo-frame-1: rgba(152, 171, 221, 0.85);
    --cromo-frame-2: #c6d4ef;
    --cromo-tier-text: #c6d4ef;
  }
  .frame-v3 {
    --cromo-c1: #5e3f0a;
    --cromo-c2: #ffd34a;
    --cromo-c3: #1a1206;
    --cromo-glow: rgba(255, 211, 74, 0.55);
    --cromo-frame-1: rgba(255, 211, 74, 0.85);
    --cromo-frame-2: #ffe27a;
    --cromo-tier-text: #ffe27a;
  }
  .frame-v4 {
    --cromo-c1: #0f4032;
    --cromo-c2: #2af0b1;
    --cromo-c3: #021510;
    --cromo-glow: rgba(42, 240, 177, 0.5);
    --cromo-frame-1: rgba(42, 240, 177, 0.85);
    --cromo-frame-2: #7df3cb;
    --cromo-tier-text: #7df3cb;
  }
  .frame-v5\+ {
    --cromo-c1: #2d0e60;
    --cromo-c2: #e066f0;
    --cromo-c3: #07041a;
    --cromo-glow: rgba(224, 102, 240, 0.55);
    --cromo-frame-1: rgba(224, 102, 240, 0.85);
    --cromo-frame-2: #f4a8f9;
    --cromo-tier-text: #f4a8f9;
  }
</style>
