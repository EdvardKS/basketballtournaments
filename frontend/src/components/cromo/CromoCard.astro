---
// SPEC-013: cromo per tournament. Receives a fully-resolved `Cromo` (theme +
// player + tournament + versionLabel) so this component has no business
// logic — it only renders.
//
// The card stays at 680x906 logical px (single source of truth for the
// export sandbox). The preview wrapper scales it via --cromo-scale; the
// theme palette is applied as inline CSS custom properties on #cromo-root
// so there is no Astro scoping ambiguity at runtime.
import type { Cromo } from "../../lib/cromos.js";
import { paletteToStyle } from "../../lib/cromos.js";
import { POSITION_ABBR } from "../../lib/cromo.js";
import { overallColor } from "../../lib/display.js";

interface Props {
  cromo: Cromo;
  active?: boolean;
}
const { cromo: c, active } = Astro.props as Props;
const positionAbbr = POSITION_ABBR[c.player.position] ?? c.player.position.slice(0, 2).toUpperCase();

const stats = [
  ["RIT", c.player.pace],     ["TIR", c.player.shooting], ["PAS", c.player.passing],
  ["REG", c.player.dribbling],["DEF", c.player.defense],  ["FIS", c.player.physical],
] as const;

const rootStyle = "position:absolute;top:0;left:0;width:680px;height:906px;transform-origin:top left;transform:scale(var(--cromo-scale,0.559));"
  + paletteToStyle(c.theme);
---
<div class="cromo-fit" style="width:clamp(280px,100%,380px);margin:0 auto;aspect-ratio:680/906;position:relative;overflow:hidden;box-sizing:border-box;--cromo-scale:0.559;">
  <div id="cromo-root" class="cromo" data-active={active ? "true" : "false"} data-tournament-id={c.tournamentId} style={rootStyle}>
    <!-- Layered background. -->
    <div class="cromo-bg" aria-hidden="true"></div>
    <div class="cromo-foil" aria-hidden="true"></div>
    <div class="cromo-spotlight" aria-hidden="true"></div>
    <div class="cromo-vignette" aria-hidden="true"></div>

    <!-- Dual-tone metallic frame. -->
    <div class="cromo-frame cromo-frame-outer" aria-hidden="true"></div>
    <div class="cromo-frame cromo-frame-inner" aria-hidden="true"></div>

    <!-- FUT-style corner notches. -->
    <span class="cromo-corner-deco cromo-corner-tl" aria-hidden="true"></span>
    <span class="cromo-corner-deco cromo-corner-tr" aria-hidden="true"></span>
    <span class="cromo-corner-deco cromo-corner-bl" aria-hidden="true"></span>
    <span class="cromo-corner-deco cromo-corner-br" aria-hidden="true"></span>

    <!-- Tournament header (SPEC-013). -->
    <div class="cromo-tournament" aria-label="Torneo">
      <div class="cromo-tname">{c.tournamentName}</div>
      <div class="cromo-tyear">{c.tournamentYear}</div>
    </div>

    <!-- Top-left: rating + divider + position. -->
    <div class="cromo-corner">
      <div class={`cromo-overall ${overallColor(c.player.overall)}`}>{c.player.overall}</div>
      <div class="cromo-divider" aria-hidden="true"></div>
      <div class="cromo-position">{positionAbbr}</div>
    </div>

    <!-- Tier badge top-right. versionLabel is the ordinal "v1", "v2", ... -->
    <div class="cromo-tier">
      <span class="cromo-tier-dot" aria-hidden="true"></span>
      {c.versionLabel.toUpperCase()}
    </div>

    <!-- Frozen-stats badge when the tournament is completed. -->
    {c.frozen ? <div class="cromo-frozen" aria-label="Cromo finalizado">FINAL</div> : null}

    <!-- Avatar zone. -->
    <div class="cromo-photo-shadow" aria-hidden="true"></div>
    <div class="cromo-photo-mask">
      {c.player.avatar ? (
        <img class="cromo-photo-img" src={c.player.avatar} alt="" crossorigin="anonymous" decoding="sync" />
      ) : (
        <div class="cromo-photo-fallback">{c.player.name.charAt(0).toUpperCase()}</div>
      )}
    </div>

    <!-- Footer: brand, name, stats. -->
    <div class="cromo-footer">
      <div class="cromo-brand" aria-hidden="true">
        <span class="cromo-brand-hair"></span>
        <span class="cromo-brand-text">VBL · {c.theme.label.toUpperCase()}</span>
        <span class="cromo-brand-hair"></span>
      </div>
      <p class="cromo-name">{c.player.name}</p>
      <div class="cromo-stats">
        {stats.map(([k, v]) => (
          <div class="cromo-stat">
            <span class="cromo-stat-val">{v}</span>
            <span class="cromo-stat-key">{k}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .cromo {
    border-radius: 32px;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    font-family: var(--font-display, "Bebas Neue", "Inter", sans-serif);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.06) inset,
      0 36px 80px -28px rgba(0,0,0,0.85),
      0 0 80px -20px var(--cromo-glow, transparent);
  }

  .cromo-frame { position: absolute; pointer-events: none; }
  .cromo-frame-outer {
    inset: 0; border-radius: 32px;
    border: 3px solid var(--cromo-frame-2);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.18),
      0 0 36px -6px var(--cromo-glow);
    z-index: 8;
  }
  .cromo-frame-inner {
    inset: 10px; border-radius: 24px;
    border: 1px solid rgba(255,255,255,0.18);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.35);
    z-index: 7;
  }

  .cromo-corner-deco {
    position: absolute; width: 32px; height: 32px; z-index: 9;
    pointer-events: none;
    background: var(--cromo-frame-2);
    box-shadow: 0 0 12px var(--cromo-glow);
  }
  .cromo-corner-tl { top: 0;    left: 0;    clip-path: polygon(0 0, 100% 0, 0 100%); border-top-left-radius: 32px; }
  .cromo-corner-tr { top: 0;    right: 0;   clip-path: polygon(100% 0, 100% 100%, 0 0); border-top-right-radius: 32px; }
  .cromo-corner-bl { bottom: 0; left: 0;    clip-path: polygon(0 0, 0 100%, 100% 100%); border-bottom-left-radius: 32px; }
  .cromo-corner-br { bottom: 0; right: 0;   clip-path: polygon(100% 0, 100% 100%, 0 100%); border-bottom-right-radius: 32px; }

  .cromo-bg {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(ellipse 65% 45% at 50% 28%, var(--cromo-c2) 0%, transparent 60%),
      radial-gradient(ellipse 80% 60% at 50% 18%, color-mix(in oklab, var(--cromo-c2) 30%, transparent), transparent 70%),
      linear-gradient(170deg, var(--cromo-c1) 0%, var(--cromo-c3) 55%, #06080f 100%);
  }
  .cromo-foil {
    position: absolute; inset: 0; z-index: 1;
    background: repeating-linear-gradient(115deg,
      rgba(255,255,255,0.08) 0 2px,
      transparent 2px 16px);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 80%);
            mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 80%);
    opacity: 0.65; pointer-events: none;
  }
  .cromo-spotlight {
    position: absolute; inset: 0; z-index: 2;
    background: radial-gradient(ellipse 60% 45% at 50% 32%, rgba(255,255,255,0.22), transparent 70%);
    pointer-events: none;
  }
  .cromo-vignette {
    position: absolute; inset: 0; z-index: 6;
    background: radial-gradient(ellipse 110% 110% at 50% 50%, transparent 55%, rgba(0,0,0,0.6) 100%);
    pointer-events: none;
  }

  /* Tournament header — sits above corner / tier, centred. */
  .cromo-tournament {
    position: absolute;
    top: 26px; left: 50%;
    transform: translateX(-50%);
    z-index: 11;
    text-align: center;
    pointer-events: none;
    max-width: 360px;
  }
  .cromo-tname {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cromo-tyear {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: var(--cromo-frame-2);
    margin-top: 2px;
    text-shadow: 0 0 18px var(--cromo-glow), 0 2px 6px rgba(0,0,0,0.55);
  }

  .cromo-corner {
    position: absolute;
    top: 100px; left: 48px;
    z-index: 10;
    display: flex; flex-direction: column; align-items: center;
  }
  .cromo-overall {
    font-size: 112px; font-weight: 900;
    letter-spacing: -0.05em; line-height: 0.82;
    text-shadow:
      0 4px 22px rgba(0,0,0,0.65),
      0 1px 0 rgba(255,255,255,0.08);
  }
  .cromo-divider {
    width: 48px; height: 3px;
    margin: 8px 0 6px;
    background: linear-gradient(90deg, transparent, currentColor 35%, currentColor 65%, transparent);
    opacity: 0.7;
  }
  .cromo-position {
    font-size: 32px; font-weight: 600;
    letter-spacing: 0.22em;
    color: rgba(255,255,255,0.96);
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }

  .cromo-tier {
    position: absolute;
    top: 110px; right: 48px;
    z-index: 10;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 18px; border-radius: 999px;
    font-size: 16px; font-weight: 700;
    letter-spacing: 0.36em; text-transform: uppercase;
    color: var(--cromo-tier-text, #fff);
    background:
      linear-gradient(180deg, rgba(0,0,0,0.6), rgba(0,0,0,0.35)),
      radial-gradient(ellipse 60% 100% at 50% 0%,
        color-mix(in oklab, var(--cromo-frame-2) 30%, transparent), transparent 70%);
    border: 1.5px solid var(--cromo-frame-2);
    box-shadow:
      0 4px 14px rgba(0,0,0,0.45),
      inset 0 1px 0 rgba(255,255,255,0.18);
  }
  .cromo-tier-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--cromo-frame-2);
    box-shadow: 0 0 12px var(--cromo-frame-2);
  }

  /* FINAL badge for frozen tournaments. */
  .cromo-frozen {
    position: absolute;
    top: 160px; right: 48px;
    z-index: 10;
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.36em;
    background: rgba(0,0,0,0.55);
    border: 1px solid rgba(255,255,255,0.18);
    color: rgba(255,255,255,0.85);
  }

  /* Photo + shadow as DOM nodes (no filter rules so html-to-image reproduces 1:1). */
  .cromo-photo-shadow {
    position: absolute;
    bottom: 246px; left: 50%;
    width: 380px; height: 70px;
    transform: translateX(-50%);
    z-index: 2;
    background: radial-gradient(ellipse 50% 50% at 50% 50%,
      rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 45%, transparent 75%);
    pointer-events: none;
  }
  .cromo-photo-mask {
    position: absolute;
    top: 160px; left: 50%;
    transform: translateX(-50%);
    width: 500px; height: 470px;
    z-index: 3;
    overflow: hidden;
    display: flex; align-items: flex-end; justify-content: center;
    border-radius: 24px;
  }
  .cromo-photo-img {
    width: 100%; height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }
  .cromo-photo-fallback {
    width: 360px; height: 360px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex; align-items: center; justify-content: center;
    font-size: 180px;
    color: rgba(255,255,255,0.45);
  }

  .cromo-footer {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 28px 44px 40px;
    z-index: 10;
    background: linear-gradient(180deg,
      transparent 0%,
      rgba(0,0,0,0.10) 25%,
      rgba(0,0,0,0.62) 55%,
      rgba(0,0,0,0.94) 100%);
  }
  .cromo-brand {
    display: flex; align-items: center; justify-content: center;
    gap: 14px; margin-bottom: 12px;
  }
  .cromo-brand-text {
    font-size: 11px;
    letter-spacing: 0.4em;
    color: rgba(255,255,255,0.6);
    white-space: nowrap;
  }
  .cromo-brand-hair {
    width: 56px; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  }
  .cromo-name {
    font-size: 46px; line-height: 1;
    letter-spacing: 0.05em; text-align: center;
    margin: 0 auto 22px;
    max-width: 600px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    text-shadow:
      0 2px 0 rgba(0,0,0,0.4),
      0 6px 20px rgba(0,0,0,0.6);
    text-transform: uppercase;
    color: #fff; font-weight: 800;
  }
  .cromo-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px 12px;
  }
  .cromo-stat {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px; padding: 14px 6px;
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255,255,255,0.14), rgba(255,255,255,0.04));
    border: 1px solid rgba(255,255,255,0.16);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.14),
      0 2px 8px rgba(0,0,0,0.4);
  }
  .cromo-stat-val {
    font-size: 40px; font-weight: 900;
    color: #fff; line-height: 0.9;
    text-shadow: 0 2px 6px rgba(0,0,0,0.55);
  }
  .cromo-stat-key {
    font-size: 12px; letter-spacing: 0.28em;
    color: rgba(255,255,255,0.65);
    font-weight: 600;
  }
</style>

<script is:inline>
  (() => {
    const tick = (el) => {
      const w = el.clientWidth || el.getBoundingClientRect().width;
      if (!w) return;
      el.style.setProperty("--cromo-scale", String(w / 680));
    };
    const mount = () => {
      document.querySelectorAll(".cromo-fit").forEach((el) => {
        if (el.dataset.cromoFitMounted === "1") return;
        el.dataset.cromoFitMounted = "1";
        requestAnimationFrame(() => tick(el));
        try {
          new ResizeObserver(() => tick(el)).observe(el);
        } catch (e) { console.warn("[cromo-fit] observer failed", e); }
      });
    };
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", mount, { once: true });
    } else {
      mount();
    }
    document.addEventListener("astro:page-load", mount);
  })();
</script>
