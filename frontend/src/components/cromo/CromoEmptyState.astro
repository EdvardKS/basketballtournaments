---
// SPEC-013: shown when the player has no cromos because they have not
// registered in any tournament yet. Surfaces the next available tournament
// if there is one open / upcoming.
import type { TournamentStatus } from "../../lib/types.js";

interface OpenTournament {
  id: string;
  name: string;
  status: TournamentStatus;
  date?: string | null;
}

interface Props {
  openTournament?: OpenTournament | null;
}
const { openTournament } = Astro.props as Props;
---
<div class="cromo-empty">
  <div class="cromo-empty-ghost" aria-hidden="true">
    <div class="cromo-empty-frame"></div>
    <div class="cromo-empty-rating">??</div>
    <div class="cromo-empty-mask"></div>
    <div class="cromo-empty-stats">
      {[0,1,2,3,4,5].map(() => <div class="cromo-empty-stat"></div>)}
    </div>
  </div>
  <div class="cromo-empty-cta">
    {openTournament ? (
      <>
        <p class="cromo-empty-title">Aún no tienes cromo</p>
        <p class="cromo-empty-sub">Inscríbete al torneo <strong>{openTournament.name}</strong> para conseguir el tuyo de esta temporada.</p>
        <a class="neon-btn neon-btn-primary cromo-empty-btn" href={`/torneos/${openTournament.id}`}>Inscribirme al torneo</a>
      </>
    ) : (
      <>
        <p class="cromo-empty-title">Tu cromo llegará pronto</p>
        <p class="cromo-empty-sub">Cuando se abra el próximo torneo, podrás inscribirte y conseguir tu cromo único de la temporada.</p>
      </>
    )}
  </div>
</div>

<style>
  .cromo-empty {
    display: flex; flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 24px;
    max-width: 420px;
    margin: 0 auto;
  }
  .cromo-empty-ghost {
    position: relative;
    width: clamp(280px, 100%, 380px);
    aspect-ratio: 680/906;
    border-radius: 28px;
    background:
      radial-gradient(ellipse 70% 50% at 50% 30%, rgba(255,255,255,0.05), transparent 60%),
      linear-gradient(180deg, #14161c 0%, #06070d 100%);
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.06),
      0 24px 60px -28px rgba(0,0,0,0.85);
  }
  .cromo-empty-frame {
    position: absolute; inset: 8px;
    border-radius: 22px;
    border: 2px dashed rgba(255,255,255,0.15);
  }
  .cromo-empty-rating {
    position: absolute;
    top: 18%; left: 12%;
    font-size: 64px; font-weight: 900;
    color: rgba(255,255,255,0.2);
    letter-spacing: -0.05em;
    font-family: "Bebas Neue", "Inter", sans-serif;
  }
  .cromo-empty-mask {
    position: absolute;
    top: 22%; left: 50%; transform: translateX(-50%);
    width: 55%; aspect-ratio: 1/1;
    border-radius: 100%;
    background: radial-gradient(circle, rgba(255,255,255,0.08), transparent 60%);
  }
  .cromo-empty-stats {
    position: absolute;
    left: 8%; right: 8%; bottom: 8%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .cromo-empty-stat {
    height: 36px;
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .cromo-empty-cta {
    text-align: center;
  }
  .cromo-empty-title {
    font-family: "Bebas Neue", "Inter", sans-serif;
    font-size: 22px;
    letter-spacing: 0.12em;
    color: #fff;
    margin: 0 0 6px;
  }
  .cromo-empty-sub {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    margin: 0 0 14px;
    line-height: 1.4;
  }
  .cromo-empty-btn {
    display: inline-flex;
  }
</style>
