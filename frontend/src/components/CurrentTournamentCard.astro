---
import { STATUS_LABEL, STATUS_COLOR, type Tournament } from "../lib/types.ts";
interface Props { tournament: Tournament; registrations: number; teams: number; }
const { tournament: t, registrations, teams } = Astro.props;
---
<section id="active-tournament" class="mb-14">
  <header class="flex items-baseline gap-3 mb-4">
    <span class="h-3 w-3 rounded-full bg-court-accent animate-pulse"></span>
    <h2 class="text-sm uppercase tracking-[0.3em] text-court-accent font-bold">
      Torneo en curso
    </h2>
  </header>

  <article class="relative rounded-2xl overflow-hidden border border-court-accent/40
                  shadow-[0_0_60px_-10px_rgba(255,107,26,0.35)]">
    <div class="absolute inset-0 bg-cover bg-center opacity-35"
         style="background-image:url('/img/court-bg.png');"></div>
    <div class="absolute inset-0"
         style="background:linear-gradient(120deg,rgba(11,15,26,.9),rgba(20,26,44,.75));"></div>

    <div class="relative p-7 md:p-10 grid md:grid-cols-[1fr_auto] gap-6 items-end">
      <div>
        <span class={`chip mb-3 ${STATUS_COLOR[t.status]}`}>{STATUS_LABEL[t.status]}</span>
        <h3 class="font-display text-5xl md:text-6xl text-white uppercase tracking-wider">
          {t.name}
        </h3>
        <p class="mt-3 text-slate-300 max-w-xl">{t.description}</p>

        <dl class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
          <div>
            <dt class="text-[10px] uppercase tracking-widest text-slate-500">Fecha</dt>
            <dd class="font-semibold text-slate-100">{t.date}</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-widest text-slate-500">Sede</dt>
            <dd class="font-semibold text-slate-100">{t.location}</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-widest text-slate-500">Equipos</dt>
            <dd class="font-display text-2xl text-court-accent">{teams}/{t.maxTeams}</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-widest text-slate-500">Inscritos</dt>
            <dd class="font-display text-2xl text-court-accent">{registrations}</dd>
          </div>
        </dl>
      </div>

      <div class="flex md:flex-col gap-3">
        <a href={`/tournaments/${t.id}`} class="btn-primary">Ver ficha completa</a>
        <a href="/register" class="btn-ghost">Crear cuenta</a>
      </div>
    </div>
  </article>
</section>
