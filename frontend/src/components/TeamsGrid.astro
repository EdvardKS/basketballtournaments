---
import type { TeamWithPlayers, Player } from "../lib/types.js";
import TeamCard from "./TeamCard.astro";

interface Props {
  teams: TeamWithPlayers[];
  authenticated?: boolean;
  captains?: Record<string, Pick<Player, "id" | "name">>;
}
const { teams, authenticated = false, captains = {} } = Astro.props;
---
{teams.length > 0 ? (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    {teams.map((team) => (
      <TeamCard
        team={team}
        authenticated={authenticated}
        captainPlayer={captains[team.captainId] ?? null}
      />
    ))}
  </div>
) : (
  <div class="card text-center py-12">
    <p class="text-4xl mb-3">🏀</p>
    <p class="text-court-muted">No hay equipos formados todavía</p>
  </div>
)}
