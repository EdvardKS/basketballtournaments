---
// "Camino a la Final" — Champions-League mirror bracket.
//
// Layout (desktop):
//   QFL · spacer · SFL · spacer · CENTER · spacer · SFR · spacer · QFR
//
// Geometry (robust against content height variations):
//   - QF pair wrapper uses `flex: 1` cells with `align-items: center` so each
//     match's vertical mid sits exactly at 25% / 75% of the wrapper height.
//   - Spacer columns host the L-shaped connectors via pseudo-elements:
//       ::before = vertical bar from 25% to 75% (joins the two QF mids).
//       ::after  = horizontal at 50% (= bar's mid → into SF).
//   - Each match cell emits a short horizontal stub via ::after to meet the
//     spacer's vertical bar.
//   - SF→CENTER spacers add a single horizontal at 50%.
//
// Mobile: the entire bracket scrolls horizontally inside an overflow wrapper.
// The grid keeps its desktop structure so columns stay aligned.
//
// Interactive: hovering over any team-pill highlights every pill with the
// same data-team-id (the team's full path through the bracket).
import type { Match } from "../lib/types.js";
import BracketMatch from "./tournament/BracketMatch.astro";

interface Props { matches: Match[]; hoursConfirmed?: boolean; isAdmin?: boolean }
const { matches, isAdmin = false } = Astro.props as Props;

const byStage = (s: string): Match[] => matches.filter((m: Match) => m.stage === s);
const findByRound = (list: Match[], round: number): Match | null =>
  list.find((m) => m.roundNumber === round) ?? null;

const eighths  = byStage("eighth");
const quarters = byStage("quarterfinal");
const semis    = byStage("semifinal");
const finals   = byStage("final");
const thirds   = byStage("third_place");

const qf1 = findByRound(quarters, 1);
const qf2 = findByRound(quarters, 2);
const qf3 = findByRound(quarters, 3);
const qf4 = findByRound(quarters, 4);
const sf1 = findByRound(semis, 1);
const sf2 = findByRound(semis, 2);
const finalMatch = findByRound(finals, 1);
const thirdMatch = findByRound(thirds, 1);

const hasKo = eighths.length + quarters.length + semis.length + finals.length + thirds.length > 0;
const hasQuarters = quarters.length > 0;
const hasEighths = eighths.length > 0;
// Eighths sorted by round_number for left→right reading.
const eighthsSorted = [...eighths].sort((a, b) => (a.roundNumber ?? 0) - (b.roundNumber ?? 0));
---
{!hasKo ? (
  <div class="rounded-xl border border-white/5 bg-court-card/40 p-8 text-center">
    <p class="text-court-muted text-sm">Las eliminatorias se generarán al acabar la fase de grupos</p>
  </div>
) : (
  <div class="bracket-root">
    {hasEighths && (
      <section class="mb-8">
        <header class="mb-3">
          <p class="text-[10px] uppercase tracking-[0.4em] text-[var(--color-neon-orange)] font-bold mb-1">Octavos de final</p>
          <p class="text-sm text-court-muted">Ronda previa al cuadro principal · ganadores avanzan a cuartos.</p>
        </header>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {eighthsSorted.map((m: Match) => (
            <BracketMatch match={m} isAdmin={isAdmin} size="sm" />
          ))}
        </div>
      </section>
    )}
    {/* The whole bracket scrolls horizontally on mobile; on desktop the grid
        fits naturally inside the page width. */}
    <div class="overflow-x-auto pb-4 -mx-4 px-4 lg:mx-0 lg:px-0">
      <div
        class="bracket-grid mx-auto"
        style={hasQuarters
          ? "grid-template-columns: minmax(200px,1fr) 3rem minmax(200px,1.05fr) 3rem minmax(280px,1.5fr) 3rem minmax(200px,1.05fr) 3rem minmax(200px,1fr); min-width: 1100px;"
          : "grid-template-columns: minmax(240px,1fr) 3rem minmax(280px,1.4fr) 3rem minmax(240px,1fr); min-width: 760px;"}
      >
        {/* ============ LEFT HALF ============ */}
        {hasQuarters && (
          <>
            <div class="bracket-pair">
              <div class="bracket-cell"><BracketMatch match={qf1} isAdmin={isAdmin} size="sm" /></div>
              <div class="bracket-cell"><BracketMatch match={qf2} isAdmin={isAdmin} size="sm" /></div>
            </div>
            <div class="bracket-spacer bracket-spacer--pair-left"></div>
          </>
        )}
        <div class="bracket-single">
          <div class="bracket-cell"><BracketMatch match={sf1} isAdmin={isAdmin} size="md" /></div>
        </div>
        <div class="bracket-spacer bracket-spacer--single-left"></div>

        {/* ============ CENTER — trophy + final + 3rd ============ */}
        <div class="bracket-center">
          <div class="text-center mb-4">
            <svg class="mx-auto w-20 h-20 text-court-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                 style="filter: drop-shadow(0 0 22px rgba(245,197,24,0.85)) drop-shadow(0 0 4px rgba(245,197,24,1));">
              <path d="M8 21h8M12 17v4M5 4h14v5a7 7 0 01-14 0V4z" />
              <path d="M5 4H2v3a4 4 0 003 4M19 4h3v3a4 4 0 01-3 4" />
            </svg>
            <p class="font-hero text-court-gold tracking-[0.45em] text-lg mt-2 animate-flicker">FINAL</p>
          </div>
          <div class="bracket-final-card rounded-2xl border-2 border-court-gold/50 p-3 mb-6"
               style="background: linear-gradient(135deg, rgba(245,197,24,0.14), rgba(20,26,44,0.7)); box-shadow: 0 0 40px rgba(245,197,24,0.35), inset 0 1px 0 rgba(255,255,255,0.08);">
            <BracketMatch match={finalMatch} isAdmin={isAdmin} size="lg" />
          </div>
          <p class="font-hero text-court-muted tracking-[0.35em] text-[10px] text-center mb-2">3ER PUESTO</p>
          <div class="rounded-xl border border-white/10 p-2"
               style="background: rgba(20,26,44,0.6);">
            <BracketMatch match={thirdMatch} isAdmin={isAdmin} size="sm" />
          </div>
        </div>

        {/* ============ RIGHT HALF (mirrored) ============ */}
        <div class="bracket-spacer bracket-spacer--single-right"></div>
        <div class="bracket-single">
          <div class="bracket-cell"><BracketMatch match={sf2} isAdmin={isAdmin} size="md" /></div>
        </div>
        {hasQuarters && (
          <>
            <div class="bracket-spacer bracket-spacer--pair-right"></div>
            <div class="bracket-pair">
              <div class="bracket-cell"><BracketMatch match={qf3} isAdmin={isAdmin} size="sm" /></div>
              <div class="bracket-cell"><BracketMatch match={qf4} isAdmin={isAdmin} size="sm" /></div>
            </div>
          </>
        )}
      </div>
    </div>
  </div>
)}

<style>
  .bracket-root {
    padding: 1.5rem 0 2rem;
  }

  .bracket-grid {
    display: grid;
    align-items: stretch;
    column-gap: 0;
    row-gap: 0;
    min-height: 36rem;
  }

  /* PAIRS: two matches each take exactly half the column height; their
     vertical centers land at 25% and 75% of the parent. */
  .bracket-pair {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 30rem;
    position: relative;
  }
  .bracket-pair > .bracket-cell {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
  }

  /* SINGLE-MATCH columns (SF, Final): centered vertically. */
  .bracket-single {
    display: flex;
    align-items: center;
    height: 100%;
  }
  .bracket-single > .bracket-cell {
    width: 100%;
    position: relative;
  }

  /* CENTER stack */
  .bracket-center {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
  }

  /* ===== CONNECTOR LINES ===== */

  /* Common visual style — subtle warm-grey line with a tiny glow. */
  .bracket-spacer {
    position: relative;
    height: 100%;
  }
  .bracket-spacer::before,
  .bracket-spacer::after,
  .bracket-cell::after {
    background: rgba(255,255,255,0.22);
    box-shadow: 0 0 4px rgba(255,255,255,0.12);
  }

  /* === LEFT HALF === */

  /* QF→SF connector spacer */
  .bracket-spacer--pair-left::before {
    content: "";
    position: absolute;
    left: 0;
    top: 25%;
    bottom: 25%;
    width: 2px;
    transform-origin: top;
    animation: draw-v 0.55s ease-out 0.1s both;
  }
  .bracket-spacer--pair-left::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    transform-origin: left;
    animation: draw-h 0.45s ease-out 0.65s both;
  }
  /* QF cells emit a horizontal stub from their center to the spacer */
  .bracket-grid > .bracket-pair:first-child > .bracket-cell::after {
    content: "";
    position: absolute;
    right: -3rem;
    top: 50%;
    width: 3rem;
    height: 2px;
    transform-origin: left;
    animation: draw-h 0.45s ease-out 0s both;
  }

  /* SF→FINAL connector spacer */
  .bracket-spacer--single-left::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    transform-origin: left;
    animation: draw-h 0.55s ease-out 1.1s both;
  }
  /* SF cell emits a stub on its right side */
  .bracket-grid > .bracket-single:nth-of-type(1) > .bracket-cell::after {
    content: "";
    position: absolute;
    right: -3rem;
    top: 50%;
    width: 3rem;
    height: 2px;
    transform-origin: left;
    animation: draw-h 0.45s ease-out 0.85s both;
  }

  /* === RIGHT HALF (mirrored) === */
  .bracket-spacer--single-right::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    transform-origin: right;
    animation: draw-h 0.55s ease-out 1.1s both;
  }
  .bracket-grid > .bracket-single:nth-of-type(2) > .bracket-cell::after {
    content: "";
    position: absolute;
    left: -3rem;
    top: 50%;
    width: 3rem;
    height: 2px;
    transform-origin: right;
    animation: draw-h 0.45s ease-out 0.85s both;
  }
  .bracket-spacer--pair-right::before {
    content: "";
    position: absolute;
    right: 0;
    top: 25%;
    bottom: 25%;
    width: 2px;
    transform-origin: top;
    animation: draw-v 0.55s ease-out 0.1s both;
  }
  .bracket-spacer--pair-right::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    transform-origin: right;
    animation: draw-h 0.45s ease-out 0.65s both;
  }
  .bracket-grid > .bracket-pair:last-child > .bracket-cell::after {
    content: "";
    position: absolute;
    left: -3rem;
    top: 50%;
    width: 3rem;
    height: 2px;
    transform-origin: right;
    animation: draw-h 0.45s ease-out 0s both;
  }

  /* ===== ANIMATIONS ===== */
  @keyframes draw-h {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @keyframes draw-v {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  /* ===== HOVER PATH HIGHLIGHT (set from inline script below) ===== */
  .team-pill.path-active {
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--accent, #ff6b00) 50%, transparent),
      color-mix(in srgb, var(--accent, #ff6b00) 12%, transparent)) !important;
    border-color: var(--accent, #ff6b00) !important;
    box-shadow: 0 0 26px var(--accent, #ff6b00),
                inset 0 0 16px rgba(255,255,255,0.10) !important;
    transform: translateY(-1px) scale(1.015);
    z-index: 5;
  }

  /* Reduced motion: skip the line draw animation. */
  @media (prefers-reduced-motion: reduce) {
    .bracket-spacer::before,
    .bracket-spacer::after,
    .bracket-cell::after {
      animation: none !important;
    }
  }
</style>

<script>
  // Hover any team-pill → light up every pill in the document with the same
  // data-team-id (= every match this team plays in, including future rounds
  // once they are propagated). Vanilla JS, runs once on hydration.
  if (typeof document !== "undefined") {
    const pills = document.querySelectorAll<HTMLElement>(".team-pill[data-team-id]");
    pills.forEach((pill) => {
      const id = pill.dataset.teamId;
      if (!id) return;
      pill.addEventListener("mouseenter", () => {
        document.querySelectorAll<HTMLElement>(`.team-pill[data-team-id="${CSS.escape(id)}"]`)
          .forEach((p) => p.classList.add("path-active"));
      });
      pill.addEventListener("mouseleave", () => {
        document.querySelectorAll<HTMLElement>(`.team-pill.path-active[data-team-id="${CSS.escape(id)}"]`)
          .forEach((p) => p.classList.remove("path-active"));
      });
    });
  }
</script>
