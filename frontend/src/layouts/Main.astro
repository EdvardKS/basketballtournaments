---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import UserNav from "../components/UserNav.astro";
import Footer from "../components/Footer.astro";
import SponsorBadge from "../components/SponsorBadge.astro";
import Toast from "../islands/ui/Toast.js";
import type { Player } from "../lib/types.js";

interface Props {
  title?: string;
  description?: string;
  player?: Player | null;
}

const { title = "Villena Basket League", description = "Liga de baloncesto amateur de Villena", player } = Astro.props;
const currentPath = Astro.url.pathname;
// Hide the floating sponsor badge only on admin operational views. Visible
// everywhere else (landing, login, register, tournaments, captain/player
// dashboards, legal pages) — the sponsorship is meant to be public.
const isAdminView = currentPath.startsWith("/dashboard/admin");
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex,nocache" />
    <meta name="googlebot" content="noindex,nofollow,noimageindex" />
    <meta name="googlebot-image" content="noindex" />
    <meta name="referrer" content="no-referrer" />
    <title>{title} · VBL</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    {player
      ? <UserNav player={player} currentPath={currentPath} />
      : <Navbar player={null} currentPath={currentPath} />
    }
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {!isAdminView && <SponsorBadge />}
    <Toast client:load />
  </body>
</html>
