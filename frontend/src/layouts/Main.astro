---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { loadSession } from "../lib/session.ts";

interface Props { title?: string; description?: string; }
const { title = "Villena Basket League", description = "Gestor de torneos de basket amateur en Villena." } = Astro.props;
const session = await loadSession(Astro.request);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Teko:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Navbar session={session} />
    <main class="max-w-6xl mx-auto px-4 py-8">
      <slot name="hero" />
      <slot session={session} />
    </main>
    <Footer />
  </body>
</html>
