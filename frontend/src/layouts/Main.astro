---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Toast from "../islands/ui/Toast.js";
import type { Player } from "../lib/types.js";

interface Props {
  title?: string;
  description?: string;
  player?: Player | null;
}

const { title = "Villena Basket League", description = "Liga de baloncesto amateur de Villena", player } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · VBL</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar player={player} currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <Toast client:load />
  </body>
</html>
