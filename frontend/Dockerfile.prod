# Multi-stage production image.
# Stage 1: install deps + astro build → dist/server/entry.mjs
# Stage 2: runtime image with only prod deps + compiled output.

FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile
COPY astro.config.mjs tsconfig.json ./
COPY src ./src
COPY public ./public
RUN pnpm build

FROM node:20-alpine AS runtime
RUN corepack enable && apk add --no-cache curl
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile --prod && pnpm store prune
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
EXPOSE 4321

# curl resolves localhost as IPv4 first; busybox wget prefers IPv6 (::1)
# and the Astro node server binds only to IPv4 → wget fails with "Connection
# refused" even though the server is up. Match the curl-based healthcheck
# used by every other frontend in the VPS.
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
  CMD curl -fsS http://localhost:4321/ >/dev/null || exit 1

CMD ["node", "dist/server/entry.mjs"]
