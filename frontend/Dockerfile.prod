# Multi-stage production image.
# Stage 1: install deps + astro build → dist/server/entry.mjs
# Stage 2: runtime image with only prod deps + compiled output.

FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile
COPY astro.config.mjs tsconfig.json ./
COPY src ./src
COPY public ./public
RUN pnpm build

FROM node:20-alpine AS runtime
RUN corepack enable && apk add --no-cache curl
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile --prod && pnpm store prune
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
EXPOSE 4321

# curl resolves localhost as IPv4 first; busybox wget prefers IPv6 (::1)
# and the Astro node server binds only to IPv4 → wget fails with "Connection
# refused" even though the server is up. Match the curl-based healthcheck
# used by every other frontend in the VPS.
#
# Hit /healthz instead of /: the landing page does SSR with an awaited
# fetch to the backend (/tournaments) and the 3s healthcheck timeout was
# tripping during cold boot of the canary (DB freshly migrated, backend
# warming up) — even though prod was healthy. /healthz is a static response
# that has no upstream dependency, so the canary turns healthy as soon as
# the Astro node server is bound, not after the first slow API hop.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=8 \
  CMD curl -fsS http://localhost:4321/healthz >/dev/null || exit 1

CMD ["node", "dist/server/entry.mjs"]
