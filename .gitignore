node_modules/
dist/
build/
.astro/
.cache/
.DS_Store

# Runtime backups (CSV exports of tournament registrations)
backend/data/csv/*
!backend/data/csv/.gitkeep

# E2E test run artefacts (per-iteration logs + findings)
backend/data/test-runs/*
!backend/data/test-runs/.gitkeep

# Past-edition photos live in frontend/public/img/photos/ now — tracked
# in git so docker compose build picks them up via COPY public ./public.

# Env files — each service has its own; never commit the real one
.env
.env.local
.env.prod
!.env.example
!.env.prod.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# E2E test runtime artefacts (scripts under backend/test/ are tracked)
/test/*.txt
/test/*.json
/test/tmp_*.txt
backend/test/*.txt
backend/test/*.json
backend/test/tmp_*

# Docker volumes mount points when used outside compose
pgdata/
*.bak
*.bak.*
.pnpm-store/
frontend/.pnpm-store/
