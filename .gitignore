node_modules/
dist/
build/
.astro/
.cache/
.DS_Store

# Runtime backups (CSV exports of tournament registrations)
backend/data/csv/*
!backend/data/csv/.gitkeep

# Past-edition photos (Instagram screenshots). Big binary blobs — they
# live next to the repo on each machine instead of inside it. Drop the
# PNGs into frontend/photos/ before `docker compose build` so the
# Dockerfile can COPY them into the image. The .gitkeep stays tracked so
# the dir exists in fresh clones (otherwise the Dockerfile COPY fails).
frontend/photos/*
!frontend/photos/.gitkeep
!frontend/photos/README.md

# Env files — each service has its own; never commit the real one
.env
.env.local
.env.prod
!.env.example
!.env.prod.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# E2E test runtime artefacts (scripts are tracked)
/test/*.txt
/test/*.json
/test/tmp_*.txt

# Docker volumes mount points when used outside compose
pgdata/
test/*