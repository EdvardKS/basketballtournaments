# DB production env. COPY to db/.env.prod and replace the password
# with a strong secret before `docker compose -f docker-compose.prod.yml up`.
POSTGRES_USER=basket
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=basket

# Production: start with empty DB (no demo data). Set to "true"
# only if you want seed tournaments / players for a staging environment.
EXAMPLE_DATA=false
