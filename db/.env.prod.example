# DB production env. COPY to db/.env.prod and replace the password
# with a strong secret before `docker compose -f docker-compose.prod.yml up`.
POSTGRES_USER=basket
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=basket

# NOTE: demo data is now controlled by EXAMPLE_DATA in backend/.env.prod
# (the backend applies seeds on boot, tracked in schema_seeds table).
